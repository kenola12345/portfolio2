---
/**
 * 全ページ共通のレイアウト。head・フォント・解析タグを持つ。
 * Phase 2 で <ClientRouter />、Phase 3 で永続化する 3D ステージをここに追加する。
 */
import '../styles/globals.css';
import Analytics from '@vercel/analytics/astro';
import { artist } from '../data/artist';

interface Props {
  title?: string;
  description?: string;
  lang?: 'en' | 'ja';
}

const {
  title = `${artist.name.en} — Discography`,
  description = artist.tagline.en,
  lang = 'en',
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- フォントは表示をブロックしないように読み込む -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Montserrat:wght@700;800;900&family=Noto+Sans+JP:wght@400;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Montserrat:wght@700;800;900&family=Noto+Sans+JP:wght@400;700&display=swap"
      />
    </noscript>

    <title>{title}</title>
  </head>
  <body>
    <slot />
    <Analytics />
  </body>
</html>
