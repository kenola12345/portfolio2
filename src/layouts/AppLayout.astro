---
/**
 * 全ページ共通のレイアウト。head・フォント・解析タグに加えて、
 * ページ遷移しても消えない 3D レコードステージ（transition:persist）を持つ。
 */
import '../styles/globals.css';
import Analytics from '@vercel/analytics/astro';
import { ClientRouter } from 'astro:transitions';
import RecordStage from '../components/stage/RecordStage';
import { albums } from '../data/albums';
import { artist } from '../data/artist';
import { ui } from '../data/ui';
import { albumTypeLabels, getLang, localePath, trackCount, useT } from '../lib/i18n';

interface Props {
  title?: string;
  description?: string;
  lang?: 'en' | 'ja';
  /** ヘッダーのグラデーションとクリスタルの光の色。棚（ホーム）は背景色のまま */
  accent?: string;
  /** アルバムページのヘッダーのグラデーションを出すか */
  glow?: boolean;
}

const lang = Astro.props.lang ?? getLang(Astro.url);
const t = useT(Astro.url);
const {
  title = `${t(artist.name)} — ${lang === 'ja' ? 'ディスコグラフィ' : 'Discography'}`,
  description = t(artist.tagline),
  accent = '#0b0b0d',
  glow = false,
} = Astro.props;

// ステージに渡すレコード一覧（Artist が先頭、あとはアルバム順）。ホバーカードの文字・リンク先もここで言語に合わせる。
// 3D ステージはページ遷移しても残る（transition:persist）が、props は遷移のたびに新しいページの値に更新される
const records = [
  {
    slug: 'artist',
    cover: artist.portrait,
    href: localePath('/artist', lang),
    title: t(artist.name),
    label: t(ui.navArtist),
    meta: t(ui.artistLabel),
    blurb: t(artist.shelfBlurb),
  },
  ...albums.map((album) => ({
    slug: album.slug,
    cover: album.cover,
    href: localePath(`/albums/${album.slug}`, lang),
    title: t(album.title),
    label: t(album.title),
    meta: `${t(albumTypeLabels[album.type])} · ${trackCount(album.tracks.length, lang)}`,
    blurb: t(album.blurb),
  })),
];
---

<!doctype html>
<html lang={lang} style={`--page-accent: ${accent}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- フォントは表示をブロックしないように読み込む -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Montserrat:wght@700;800;900&family=Noto+Sans+JP:wght@400;700&display=swap"
    />

    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <!--
      ローディング画面。HTML に最初から入れておくので、JS が動く前に中身がちらっと見えることがない。
      transition:persist なのでページ遷移しても作り直されず、閉じたまま残る。
      バーの進みは RecordStage の LoadingBridge が --progress に書き込む
    -->
    <div id="loading-screen" transition:persist="loading-screen" role="presentation">
      <p class="menu-text loading-name">{t(artist.name)}</p>
      <div class="loading-bar" aria-hidden="true"><div class="loading-bar__fill"></div></div>
      <p class="menu-text loading-pct" aria-hidden="true"><span data-pct>0</span>%</p>
    </div>
    <noscript><style>#loading-screen{display:none}.enter,.enter-slide{animation-play-state:running!important}</style></noscript>
    <script is:inline>
      // 読み込みに失敗しても画面が隠れたままにならないよう、20 秒で必ず閉じる
      if (!window.__loadGuard) {
        window.__loadGuard = setTimeout(function () {
          var el = document.getElementById('loading-screen');
          if (el) el.setAttribute('data-done', '');
        }, 20000);
      }
    </script>
    <div class="aurora" aria-hidden="true"></div>
    {glow && <div class="page-glow" aria-hidden="true"></div>}
    <RecordStage client:only="react" transition:persist="record-stage" records={records} />
    <slot />
    <Analytics />
  </body>
</html>
