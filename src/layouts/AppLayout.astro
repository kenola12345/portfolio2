---
/**
 * 全ページ共通のレイアウト。head・フォント・解析タグに加えて、
 * ページ遷移しても消えない 3D レコードステージ（transition:persist）を持つ。
 */
import '../styles/globals.css';
import Analytics from '@vercel/analytics/astro';
import { ClientRouter } from 'astro:transitions';
import RecordStage from '../components/stage/RecordStage';
import { albums } from '../data/albums';
import { artist } from '../data/artist';

interface Props {
  title?: string;
  description?: string;
  lang?: 'en' | 'ja';
  /** ヘッダーのグラデーションとクリスタルの光の色。棚（ホーム）は背景色のまま */
  accent?: string;
  /** アルバムページのヘッダーのグラデーションを出すか */
  glow?: boolean;
}

const {
  title = `${artist.name.en} — Discography`,
  description = artist.tagline.en,
  lang = 'en',
  accent = '#0b0b0d',
  glow = false,
} = Astro.props;

// ステージに渡すレコード一覧（Artist が先頭、あとはアルバム順）
const records = [
  { slug: 'artist', cover: artist.portrait },
  ...albums.map((album) => ({ slug: album.slug, cover: album.cover })),
];
---

<!doctype html>
<html lang={lang} style={`--page-accent: ${accent}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- フォントは表示をブロックしないように読み込む -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Montserrat:wght@700;800;900&family=Noto+Sans+JP:wght@400;700&display=swap"
    />

    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <div class="aurora" aria-hidden="true"></div>
    {glow && <div class="page-glow" aria-hidden="true"></div>}
    <RecordStage client:only="react" transition:persist="record-stage" records={records} />
    <slot />
    <Analytics />
  </body>
</html>
