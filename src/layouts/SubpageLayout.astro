---
/**
 * サブページ（各アルバム・自己紹介）の共通の枠：SideBLayout に、ナビ（現在のページを強調）と
 * 下部の連絡先フッターを足したもの。中身（ヒーローやトラックリスト）は slot に入れる。
 */
import SideBLayout from './SideBLayout.astro';
import SiteNav from '../components/home/SiteNav.astro';
import ContactFooter from '../components/home/ContactFooter.astro';
import { pageNavLinks } from '../lib/navLinks';

interface Props {
  title?: string;
  description?: string;
  /** 'artist' または アルバムの slug。ナビでこのページを強調する */
  current: string;
}

const { title, description, current } = Astro.props;
const links = pageNavLinks(Astro.url, current);
---

<SideBLayout title={title} description={description}>
  <SiteNav links={links} overlay={false} />
  <main>
    <slot />
  </main>
  <ContactFooter />
</SideBLayout>
