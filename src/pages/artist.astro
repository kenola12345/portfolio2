---
/**
 * アーティストページ（= About me）。音楽アプリのアーティストプロフィール風。
 * 自分のレコード（ポートレート）が左上で回る。
 */
import AppLayout from '../layouts/AppLayout.astro';
import PageHeader from '../components/album/PageHeader.astro';
import { albums } from '../data/albums';
import { artist } from '../data/artist';
import { ui } from '../data/ui';
import { t } from '../lib/i18n';

/** SNS アイコンのファイル（既存の public/icons を使う） */
const iconFor = { github: '/icons/github.svg', linkedin: '/icons/linkedIn.svg', email: '/icons/gmail.svg' } as const;
---

<AppLayout title={`${t(artist.name)} — Artist`} accent={artist.accent} glow>
  <main class="relative z-10 wrap pb-32">
    <PageHeader slug="artist" label={t(ui.artistLabel)} title={t(artist.name)}>
      <p class="mt-3 text-sm md:mt-5 md:text-base">
        <span class="menu-text">✓ {t(ui.verifiedArtist)}</span>
        <span class="text-muted"> · {t(artist.tagline)}</span>
      </p>
    </PageHeader>

    <section class="enter mt-12" style="--i:2">
      <h2 class="menu-text text-xl md:text-2xl">{t(ui.about)}</h2>
      <div class="crystal mt-4 grid overflow-hidden md:grid-cols-[minmax(0,360px)_1fr]" style="--crystal-radius: 22px">
        <img
          class="aspect-[4/3] w-full object-cover object-[50%_78%] md:aspect-auto md:h-full md:object-top"
          src={artist.banner}
          alt={t(artist.name)}
          loading="lazy"
          width="844"
          height="1500"
        />
        <div class="p-5 md:p-8">
          <p class="max-w-xl text-base leading-relaxed md:text-xl">{t(artist.bio)}</p>
          <ul class="mt-6 flex flex-wrap gap-2.5">
            {
              artist.socials.map((s) => (
                <li>
                  <a
                    class="crystal menu-text inline-flex items-center gap-2 px-4 py-2 text-sm"
                    style="--crystal-radius: 999px"
                    href={s.href}
                    target={s.href.startsWith('http') ? '_blank' : undefined}
                    rel="noreferrer"
                  >
                    <img class="size-4 invert" src={iconFor[s.kind]} alt="" width="16" height="16" />
                    {s.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <section class="enter mt-14" style="--i:3">
      <h2 class="menu-text text-xl md:text-2xl">{t(ui.discography)}</h2>
      <ul class="mt-4 grid grid-cols-2 gap-4 md:grid-cols-4 md:gap-6">
        {
          albums.map((album) => (
            <li>
              <a href={`/albums/${album.slug}`} class="block">
                <img
                  class="crystal aspect-square w-full object-cover"
                  style="--crystal-radius: 14px"
                  src={album.cover}
                  alt=""
                  width="768"
                  height="768"
                  loading="lazy"
                />
                <span class="menu-text mt-3 block">{t(album.title)}</span>
                <span class="text-xs text-muted md:text-sm">{album.type}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</AppLayout>
