---
/**
 * ホーム（棚）。ジャケット（カード）の裏にレコードが隠れていて、
 * ホバーで少し顔を出し、クリックで引き出されてアルバムページへ飛んでいく。
 * レコード本体は永続化した 3D ステージが描く（RecordStage）。
 */
import AppLayout from '../layouts/AppLayout.astro';
import { albums } from '../data/albums';
import { artist } from '../data/artist';
import { ui } from '../data/ui';
import { t } from '../lib/i18n';

const shelf = [
  { slug: 'artist', href: '/artist', cover: artist.portrait, title: t(artist.name), label: t(ui.artistLabel) },
  ...albums.map((album) => ({
    slug: album.slug,
    href: `/albums/${album.slug}`,
    cover: album.cover,
    title: t(album.title),
    label: `${album.type} · ${album.tracks.length} ${t(album.tracks.length === 1 ? ui.track : ui.tracks)}`,
  })),
];
---

<AppLayout>
  <main class="relative z-10 wrap pt-14 pb-28 md:pt-20">
    <header class="enter">
      <p class="menu-text text-sm tracking-[0.25em] opacity-70">DISCOGRAPHY</p>
      <h1 class="menu-text mt-2 text-4xl uppercase md:text-7xl">{t(artist.name)}</h1>
      <p class="mt-3 text-muted">{t(artist.tagline)}</p>
    </header>

    <!-- ジャケットの上にレコードがはみ出す分の余白を確保している -->
    <nav aria-label={t(ui.albumsNav)}>
      <ul class="mt-[150px] grid grid-cols-2 gap-x-4 gap-y-[130px] md:mt-[190px] md:grid-cols-5 md:gap-x-6">
        {
          shelf.map((item, i) => (
            <li class="enter-slide" style={`--i:${i}`}>
              <a data-card={item.slug} href={item.href} class="group block">
                <img
                  class="crystal aspect-square w-full object-cover"
                  style="--crystal-radius: 14px"
                  src={item.cover}
                  alt=""
                  width="768"
                  height="768"
                />
                <span class="menu-text mt-4 block text-base md:text-lg">{item.title}</span>
                <span class="mt-0.5 block text-xs tracking-wide text-muted md:text-sm">{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <p class="menu-text enter mt-24 text-center text-lg md:text-2xl" style="--i:8">
      <span class="opacity-60">···</span> Menu Selection
    </p>
    <p class="enter mt-2 text-center text-xs text-muted md:text-sm" style="--i:9">
      <span class="hidden md:inline">{t(ui.hintKeys)}</span>
      <span class="md:hidden">{t(ui.hintTouch)}</span>
    </p>
  </main>
</AppLayout>
