---
/**
 * ホーム。3D のレコードプレーヤーとジャケットが並ぶ 1 画面（100svh）。
 * ジャケットとレコードは永続化した 3D ステージ（RecordStage）が描き、クリックできる。
 * このページの DOM は「画面の高さを確保する枠」「キーボード・スクリーンリーダー用のリンク」
 * 「スクロールすると出てくる名前と連絡先のフッター」だけ。
 */
import AppLayout from '../layouts/AppLayout.astro';
import HomeNav from '../components/ui/HomeNav.astro';
import SiteFooter from '../components/ui/SiteFooter.astro';
import { albums } from '../data/albums';
import { artist } from '../data/artist';
import { ui } from '../data/ui';
import { albumTypeLabels, getLang, localePath, trackCount, useT } from '../lib/i18n';

const t = useT(Astro.url);
const lang = getLang(Astro.url);

const links = [
  {
    slug: 'artist',
    href: localePath('/artist', lang),
    title: t(artist.name),
    label: t(ui.navArtist),
    blurb: t(artist.shelfBlurb),
    cover: artist.portrait,
    meta: t(ui.artistLabel),
  },
  ...albums.map((album) => ({
    slug: album.slug,
    href: localePath(`/albums/${album.slug}`, lang),
    title: t(album.title),
    label: t(album.title),
    blurb: t(album.blurb),
    cover: album.cover,
    meta: `${t(albumTypeLabels[album.type])} · ${trackCount(album.tracks.length, lang)}`,
  })),
];
---

<AppLayout>
  <!-- main は透明にしてクリックを通し、後ろの 3D キャンバスを直接クリックできるようにする -->
  <!-- 上端にカーソルを持っていくと降りてくるナビ（ほかのページへの移動と言語の切り替え） -->
  <HomeNav />
  <main class="pointer-events-none relative z-10">
    <h1 class="sr-only">{t(artist.name)} — {lang === 'ja' ? 'ディスコグラフィ' : 'Discography'}</h1>

    <section data-stage-home class="relative min-h-svh">
      <!-- 左上の名前と肩書き（小さく）。押すと自己紹介のページへ -->
      <a href={localePath('/artist', lang)} class="home-id pointer-events-auto">
        <!-- レコードプレーヤーのアイコン（台・ターンテーブル・トーンアーム） -->
        <svg class="home-id__icon" viewBox="0 0 32 32" width="38" height="38" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="5" width="28" height="22" rx="3.5" />
          <circle cx="13.5" cy="16" r="7.5" />
          <circle cx="13.5" cy="16" r="3.6" />
          <circle cx="13.5" cy="16" r="1" fill="currentColor" stroke="none" />
          <circle cx="25" cy="9.5" r="1.8" />
          <path d="M25 11.3V17.5L21.8 21" />
        </svg>
        <span class="home-id__text">
          <span class="home-id__name menu-text">{t(artist.name)}</span>
          <span class="home-id__role">{t(artist.tagline)}</span>
        </span>
      </a>

      <!-- 見た目には出さない。キーボードで選べる実際のリンク（フォーカスすると 3D のレコードが顔を出す） -->
      <nav aria-label={t(ui.albumsNav)} class="home-sr-nav sr-only pointer-events-auto">
        <ul>
          {
            links.map((item) => (
              <li>
                <a data-card={item.slug} href={item.href}>
                  {item.title}<span class="sr-only"> — {item.blurb}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- 3D が使えないときの 2D 表示（以前のジャケット一覧）。普段は隠れていて、html の data-3d="off" のときだけ出る -->
      <ul class="home-fallback pointer-events-auto" aria-label={t(ui.albumsNav)}>
        {
          links.map((item) => (
            <li>
              <a href={item.href} class="block">
                <img
                  class="crystal aspect-square w-full object-cover"
                  style="--crystal-radius: 14px"
                  src={item.cover}
                  alt=""
                  width="768"
                  height="768"
                  loading="lazy"
                />
                <span class="menu-text mt-4 block text-base md:text-lg">{item.label}</span>
                <span class="mt-0.5 block text-xs tracking-wide text-muted md:text-sm">{item.meta}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <!-- 操作のヒント。台はドラッグで回せることを、カーソル（つかむ手）と合わせて伝える。一度回したら消える -->
      <p class="drag-hint crystal menu-text" style="--crystal-radius: 999px" aria-hidden="true">
        <svg class="drag-hint__icon" viewBox="0 0 32 32" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M8 11 3 16l5 5" />
          <path d="M24 11l5 5-5 5" />
          <path d="M4 16h24" opacity="0.45" />
          <circle class="drag-hint__dot" cx="16" cy="16" r="3.2" fill="currentColor" stroke="none" />
        </svg>
        <span>{t(ui.dragHint)}</span>
        <span class="drag-hint__sep">·</span>
        <span class="drag-hint__click">{t(ui.clickHint)}</span>
      </p>
    </section>

    <SiteFooter />
  </main>
</AppLayout>
