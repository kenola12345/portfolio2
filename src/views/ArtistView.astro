---
/**
 * アーティストページ（= 自己紹介、SIDE B デザイン）。ヒーロー、プロフィール（写真・紹介文・基本情報・SNS）、
 * 各アルバムへのカード一覧。
 */
import SubpageLayout from '../layouts/SubpageLayout.astro';
import PageHero from '../components/album/PageHero.astro';
import SocialLinks from '../components/home/SocialLinks.astro';
import ReleaseCard from '../components/home/ReleaseCard.astro';
import { albums } from '../data/albums';
import { artist } from '../data/artist';
import { ui } from '../data/ui';
import { albumTypeLabels, getLang, localePath, trackCount, useT } from '../lib/i18n';

const t = useT(Astro.url);
const lang = getLang(Astro.url);
---

<SubpageLayout title={`${t(artist.name)} — ${t(ui.artistLabel)}`} description={t(artist.tagline)} current="artist">
  <PageHero kicker={t(ui.artistLabel)} title={t(artist.name)} cover={artist.portrait} accent={artist.accent} number="01">
    <Fragment slot="byline">
      <span>{t(artist.tagline)}</span>
    </Fragment>
  </PageHero>

  <section class="profile">
    <img class="portrait" src={artist.banner} alt={t(artist.name)} width="900" height="1200" loading="lazy" data-reveal />
    <div class="profile-copy">
      <h2 data-reveal>{t(ui.about)}</h2>
      <p class="bio" data-reveal>{t(artist.bio)}</p>
      <dl data-reveal>
        {
          artist.facts.map((fact) => (
            <>
              <dt>{t(fact.label)}</dt>
              <dd>{t(fact.value)}</dd>
            </>
          ))
        }
      </dl>
      <div class="socials" data-reveal><SocialLinks variant="profile" /></div>
    </div>
  </section>

  <section class="discography">
    <header data-reveal>
      <p class="eyebrow"><span>02</span> {t(ui.discography)}</p>
      <h2>{t(ui.discography)}</h2>
    </header>
    <div class="grid">
      {
        albums.map((album, i) => (
          <ReleaseCard
            index={i}
            title={t(album.title)}
            type={`${t(albumTypeLabels[album.type])} · ${trackCount(album.tracks.length, lang)}`}
            cover={album.cover}
            alt={t(album.title)}
            href={localePath(`/albums/${album.slug}`, lang)}
            color={album.accent}
            viewLabel={t(album.title)}
          />
        ))
      }
    </div>
  </section>
</SubpageLayout>

<style>
  .profile {
    display: grid;
    grid-template-columns: minmax(0, 380px) 1fr;
    gap: 6vw;
    padding: 110px var(--gutter);
    background: var(--ink-2);
  }
  .portrait {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 35%;
    box-shadow: 14px 14px 0 var(--acid);
  }
  .profile h2 {
    font: 800 clamp(48px, 7vw, 108px) / 0.86 var(--font-display);
    letter-spacing: -0.07em;
    text-transform: uppercase;
  }
  /* "DISCOGRAPHY" は長い 1 語（約 11.5em）なので、見出しの幅に合わせた大きさにして、はみ出さないようにする */
  .discography header {
    container-type: inline-size;
  }
  .discography h2 {
    font: 800 clamp(24px, 8cqi, 108px) / 0.86 var(--font-display);
    letter-spacing: -0.07em;
    text-transform: uppercase;
  }
  .bio {
    max-width: 640px;
    margin: 40px 0;
    font-size: 14px;
    line-height: 1.85;
    color: #aaa79e;
  }
  dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 14px 28px;
    max-width: 640px;
    margin: 0;
    font-size: 12px;
    line-height: 1.7;
  }
  dt {
    color: var(--acid);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  dd {
    margin: 0;
  }
  .socials {
    margin-top: 40px;
  }

  .discography {
    padding: 110px var(--gutter) 130px;
    background: var(--paper);
    color: var(--ink);
    overflow: hidden;
  }
  .discography header {
    padding-bottom: 50px;
    border-bottom: 1px solid #aaa69a;
  }
  .eyebrow {
    display: flex;
    gap: 18px;
    margin-bottom: 30px;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .eyebrow span {
    color: var(--coral);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2.5vw;
    padding-top: 70px;
  }

  @media (max-width: 900px) {
    .profile {
      grid-template-columns: 1fr;
      gap: 60px;
    }
    .portrait {
      max-width: 420px;
    }
    .grid {
      grid-template-columns: 1fr 1fr;
      row-gap: 60px;
    }
  }
  @media (max-width: 620px) {
    .profile,
    .discography {
      padding: 80px 20px;
    }
    .profile h2 {
      font-size: 14vw;
    }
    dl {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    dd {
      margin-bottom: 14px;
    }
    .grid {
      gap: 24px;
    }
  }
</style>
