---
/**
 * アーティストページ（= About me）。音楽アプリのアーティストプロフィール風。
 * 自分のレコード（ポートレート）が左上で回る。
 */
import AppLayout from '../layouts/AppLayout.astro';
import PageHeader from '../components/album/PageHeader.astro';
import SiteFooter from '../components/ui/SiteFooter.astro';
import SocialLinks from '../components/ui/SocialLinks.astro';
import { albums } from '../data/albums';
import { artist } from '../data/artist';
import { ui } from '../data/ui';
import { albumTypeLabels, getLang, localePath, useT } from '../lib/i18n';

const t = useT(Astro.url);
const lang = getLang(Astro.url);
---

<AppLayout title={`${t(artist.name)} — ${t(ui.artistLabel)}`} accent={artist.accent} glow>
  <main class="relative z-10 wrap pb-8">
    <PageHeader slug="artist" cover={artist.portrait} label={t(ui.artistLabel)} title={t(artist.name)}>
      <p class="mt-3 text-sm md:mt-5 md:text-base">
        <span class="menu-text">✓ {t(ui.verifiedArtist)}</span>
        <span class="text-muted"> · {t(artist.tagline)}</span>
      </p>
    </PageHeader>

    <section class="enter mt-12" style="--i:2">
      <h2 class="menu-text text-xl md:text-2xl">{t(ui.about)}</h2>
      <div class="crystal mt-4 grid overflow-hidden md:grid-cols-[minmax(0,360px)_1fr]" style="--crystal-radius: 22px">
        <img
          class="aspect-[4/3] w-full object-cover object-[50%_78%] md:aspect-auto md:h-full md:object-top"
          src={artist.banner}
          alt={t(artist.name)}
          loading="lazy"
          width="844"
          height="1500"
        />
        <div class="p-5 md:p-8">
          <p class="max-w-2xl text-base leading-relaxed md:text-lg">{t(artist.bio)}</p>
          <dl class="mt-6 grid max-w-2xl gap-x-6 gap-y-3 text-sm md:grid-cols-[auto_1fr] md:text-base">
            {
              artist.facts.map((fact) => (
                <>
                  <dt class="menu-text text-muted">{t(fact.label)}</dt>
                  <dd>{t(fact.value)}</dd>
                </>
              ))
            }
          </dl>
          <SocialLinks class="mt-6" />
        </div>
      </div>
    </section>

    <section class="enter mt-14" style="--i:3">
      <h2 class="menu-text text-xl md:text-2xl">{t(ui.discography)}</h2>
      <ul class="mt-4 grid grid-cols-2 gap-4 md:grid-cols-4 md:gap-6">
        {
          albums.map((album) => (
            <li>
              <a href={localePath(`/albums/${album.slug}`, lang)} class="block">
                <img
                  class="crystal aspect-square w-full object-cover"
                  style="--crystal-radius: 14px"
                  src={album.cover}
                  alt=""
                  width="768"
                  height="768"
                  loading="lazy"
                />
                <span class="menu-text mt-3 block">{t(album.title)}</span>
                <span class="text-xs text-muted md:text-sm">{t(albumTypeLabels[album.type])}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
  <SiteFooter />
</AppLayout>
