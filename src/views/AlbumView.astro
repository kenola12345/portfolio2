---
/**
 * アルバムページ（SIDE B デザイン）。大きなタイトルと回るレコードのヒーロー、再生ボタン、
 * 開閉するトラックリスト、ライナーノーツ。
 */
import SubpageLayout from '../layouts/SubpageLayout.astro';
import PageHero from '../components/album/PageHero.astro';
import Tracklist from '../components/album/Tracklist.astro';
import type { Album } from '../data/types';
import { albums } from '../data/albums';
import { artist } from '../data/artist';
import { ui } from '../data/ui';
import { albumTypeLabels, getLang, localePath, trackCount, useT } from '../lib/i18n';

interface Props {
  album: Album;
}
const { album } = Astro.props;
const t = useT(Astro.url);
const lang = getLang(Astro.url);
const number = String(albums.findIndex((a) => a.slug === album.slug) + 2).padStart(2, '0');
---

<SubpageLayout title={`${t(album.title)} — ${t(artist.name)}`} description={t(album.blurb)} current={album.slug}>
  <PageHero
    kicker={t(albumTypeLabels[album.type])}
    meta={trackCount(album.tracks.length, lang)}
    title={t(album.title)}
    cover={album.cover}
    accent={album.accent}
    number={number}
  >
    <Fragment slot="byline">
      <img src={artist.portrait} alt="" width="26" height="26" />
      <a href={localePath('/artist', lang)}>{t(artist.name)}</a>
      {/* 年が未確定のアルバムは年を出さない */}
      {album.year && <span>· {lang === 'ja' ? `${album.year}年` : album.year}</span>}
      <span>· {t(album.blurb)}</span>
    </Fragment>

    <!-- 再生ボタン：最初のトラックを開く。開いている状態で押すと次のトラックへ進む（最後まで行ったら最初に戻る） -->
    <button type="button" data-play aria-label={t(ui.play)} class="play">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
        <path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z" />
      </svg>
      <span>{t(ui.play)}</span>
    </button>
  </PageHero>

  <section class="tracks">
    <Tracklist tracks={album.tracks} discs={album.discs} />

    {
      album.linerNotes && (
        <section class="liner" data-reveal>
          <h2>{t(ui.linerNotes)}</h2>
          <p>{t(album.linerNotes)}</p>
        </section>
      )
    }
  </section>
</SubpageLayout>

<style>
  .play {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 8px 26px 8px 8px;
    border-radius: 999px;
    background: var(--coral);
    color: var(--ink);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    box-shadow: 6px 6px 0 var(--paper);
    transition: transform 0.25s, box-shadow 0.25s, background 0.25s;
  }
  .play svg {
    box-sizing: content-box;
    padding: 14px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--coral);
    transition: color 0.25s;
  }
  .play:hover {
    background: var(--acid);
    transform: translate(-2px, -2px);
    box-shadow: 8px 8px 0 var(--paper);
  }
  .play:hover svg {
    color: var(--acid);
  }
  .tracks {
    padding: 100px var(--gutter) 130px;
    background: var(--ink-2);
  }
  .liner {
    max-width: 640px;
    margin-top: 90px;
  }
  .liner h2 {
    font: 800 clamp(26px, 3vw, 40px) var(--font-display);
    letter-spacing: -0.05em;
  }
  .liner p {
    margin-top: 14px;
    font-size: 13px;
    line-height: 1.8;
    color: var(--muted);
  }
  @media (max-width: 620px) {
    .tracks {
      padding: 70px 20px 90px;
    }
  }
</style>
