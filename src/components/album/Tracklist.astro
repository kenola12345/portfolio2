---
/**
 * トラックリスト。1 行 = 1 トラック（プロジェクト 1 件など）で、クリックするとその場で開く。
 * <details name="tracks"> なので 1 つ開くと他は閉じる（JS なしで動く）。
 */
import type { Track } from '../../data/types';
import { t } from '../../lib/i18n';

interface Props {
  tracks: Track[];
}

const { tracks } = Astro.props;

/** 外部リンクだけ別タブで開く（mailto は対象外） */
const isExternal = (href: string) => /^https?:\/\//.test(href);
---

<ol class="mt-8 flex flex-col gap-2.5">
  {
    tracks.map((track, i) => (
      <li class="enter" style={`--i:${i + 3}`}>
        <details name="tracks" id={track.slug} class="crystal group scroll-mt-6" style="--crystal-radius: 18px">
          <summary class="grid cursor-pointer list-none grid-cols-[2rem_1fr_auto] items-center gap-3 px-4 py-3.5 md:grid-cols-[2.5rem_1fr_auto] md:px-5 [&::-webkit-details-marker]:hidden">
            <span class="relative text-center text-sm text-muted">
              <span class="transition-opacity group-hover:opacity-0 group-open:opacity-0">{i + 1}</span>
              <svg
                class="absolute inset-0 m-auto opacity-0 transition-opacity group-hover:opacity-100 group-open:opacity-100"
                viewBox="0 0 24 24"
                width="16"
                height="16"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z" />
              </svg>
            </span>
            <span class="min-w-0">
              <span class="menu-text block truncate text-base md:text-lg">{t(track.title)}</span>
              {track.tags && (
                <span class="block truncate text-xs text-muted md:text-sm">{track.tags.join(' · ')}</span>
              )}
            </span>
            <span class="text-xs text-muted md:text-sm">{track.meta ? t(track.meta) : ''}</span>
          </summary>

          <div class="px-4 pb-5 pt-1 md:pl-[4.5rem] md:pr-5">
            {track.description && <p class="max-w-2xl text-sm leading-relaxed md:text-base">{t(track.description)}</p>}
            {track.bullets && (
              <ul class="mt-3 list-disc space-y-1 pl-5 text-sm md:text-base">
                {track.bullets.map((b) => (
                  <li>{t(b)}</li>
                ))}
              </ul>
            )}
            {track.images?.map((img) => (
              <img
                class="mt-4 w-full max-w-xl rounded-card"
                src={img.src}
                alt={t(img.alt)}
                loading="lazy"
                decoding="async"
              />
            ))}
            {track.tags && (
              <ul class="mt-4 flex flex-wrap gap-2">
                {track.tags.map((tag) => (
                  <li class="rounded-full bg-white/10 px-3 py-1 text-xs md:text-sm">{tag}</li>
                ))}
              </ul>
            )}
            {track.links && (
              <p class="mt-4 flex flex-wrap gap-2.5">
                {track.links.map((link) => (
                  <a
                    class="crystal menu-text inline-block px-4 py-2 text-sm"
                    style="--crystal-radius: 999px"
                    href={link.href}
                    target={isExternal(link.href) ? '_blank' : undefined}
                    rel={isExternal(link.href) ? 'noreferrer' : undefined}
                  >
                    {link.label} ↗
                  </a>
                ))}
              </p>
            )}
          </div>
        </details>
      </li>
    ))
  }
</ol>

<script>
  // #トラック名 つきの URL（または再生ボタン）で、その行を開く
  function openFromHash() {
    const id = decodeURIComponent(location.hash.slice(1));
    if (!id) return;
    const el = document.getElementById(id);
    if (el instanceof HTMLDetailsElement) el.open = true;
  }
  document.addEventListener('astro:page-load', openFromHash);
  window.addEventListener('hashchange', openFromHash);
</script>
