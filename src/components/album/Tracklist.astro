---
/**
 * トラックリスト。1 行 = 1 トラック（プロジェクト 1 件など）で、クリックするとその場で開く。
 * <details name="tracks"> なので 1 つ開くと他は閉じる（JS なしで動く）。
 */
import type { Album, Track } from '../../data/types';
import { ui } from '../../data/ui';
import { useT } from '../../lib/i18n';

interface Props {
  tracks: Track[];
  /** ディスクが複数あるアルバムのとき、ディスクごとの見出しを出す */
  discs?: Album['discs'];
}

const { tracks, discs } = Astro.props;
const t = useT(Astro.url);

/**
 * トラックをディスクごとにまとめる（1 枚だけのアルバムは見出しなしの 1 グループ）。
 * 番号はディスクごとに 1 から振り直す。index は登場アニメーションの遅延に使う通し番号
 */
const discCount = discs?.length ?? 1;
const groups = Array.from({ length: discCount }, (_, d) => {
  const items = tracks
    .map((track, index) => ({ track, index }))
    .filter(({ track }) => (track.disc ?? 1) === d + 1)
    .map((item, n) => ({ ...item, number: n + 1 }));
  return { disc: d + 1, title: discs?.[d]?.title, items };
}).filter((g) => g.items.length > 0);

/** 外部リンクだけ別タブで開く（mailto は対象外） */
const isExternal = (href: string) => /^https?:\/\//.test(href);
---

<div class="tracklist">
  {
    groups.map((group) => (
      <section aria-label={group.title ? `${t(ui.disc)} ${group.disc}: ${t(group.title)}` : undefined}>
        {group.title && (
          <h2 class="disc-title">
            <span class="disc-icon" aria-hidden="true" />
            <span class="disc-no">
              {t(ui.disc)} {group.disc}
            </span>
            <span class="disc-name">{t(group.title)}</span>
          </h2>
        )}
        <ol>
          {group.items.map(({ track, number }) => (
            <li data-reveal>
              <details data-track id={track.slug}>
                <summary>
                  <span class="no">{String(number).padStart(2, '0')}</span>
                  <span class="title">
                    <span class="name">{t(track.title)}</span>
                    {track.meta && <span class="meta-sp">{t(track.meta)}</span>}
                  </span>
                  <span class="meta-pc">{track.meta ? t(track.meta) : ''}</span>
                  <span class="plus" aria-hidden="true" />
                </summary>

                <div data-track-body class="body">
                  {track.description && <p class="desc">{t(track.description)}</p>}
                  {track.bullets && (
                    <ul class="bullets">
                      {track.bullets.map((b) => (
                        <li>{t(b)}</li>
                      ))}
                    </ul>
                  )}
                  {track.images?.map((img) => (
                    <img
                      class="shot"
                      src={img.src}
                      alt={t(img.alt)}
                      width={img.width}
                      height={img.height}
                      loading="lazy"
                      decoding="async"
                    />
                  ))}
                  {track.tags && (
                    <ul class="tags">
                      {track.tags.map((tag) => (
                        <li>{tag}</li>
                      ))}
                    </ul>
                  )}
                  {track.links && (
                    <p class="links">
                      {track.links.map((link) => (
                        <Fragment>
                        {link.href.startsWith('mailto:') && (
                          <button type="button" class="copy" data-copy={link.href.replace('mailto:', '')} data-done={t(ui.copied)}>
                            <span>{t(ui.copyEmail)}</span>
                          </button>
                        )}
                        <a
                          href={link.href}
                          target={isExternal(link.href) ? '_blank' : undefined}
                          rel={isExternal(link.href) ? 'noreferrer' : undefined}
                        >
                          {t(link.label)} ↗
                        </a>
                        </Fragment>
                      ))}
                    </p>
                  )}
                </div>
              </details>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</div>

<style>
  .tracklist {
    display: flex;
    flex-direction: column;
    gap: calc(64 * var(--u));
  }
  ol {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--line);
  }
  .disc-title {
    display: flex;
    align-items: center;
    gap: calc(14 * var(--u));
    margin-bottom: calc(18 * var(--u));
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .disc-icon {
    width: calc(18 * var(--u));
    height: calc(18 * var(--u));
    border: 1.5px solid var(--acid);
    border-radius: 50%;
    position: relative;
  }
  .disc-icon::after {
    content: '';
    position: absolute;
    inset: calc(4 * var(--u));
    border: 1.5px solid var(--acid);
    border-radius: 50%;
  }
  .disc-no {
    color: var(--acid);
  }
  .disc-name {
    /* 小文字まじりの見出しは 600 にする（Syne の 700・800 は g や y のしっぽが横に切れた形で、欠けて見えるため） */
    font: 600 clamp(1.375rem, 2.6vw, 2.125rem) var(--font-display);
    letter-spacing: -0.04em;
    text-transform: none;
  }

  details {
    border-top: 1px solid var(--line);
    scroll-margin-top: calc(24 * var(--u));
    transition: background 0.3s;
  }
  details[open],
  details:hover {
    background: #eeeade08;
  }
  summary {
    display: grid;
    grid-template-columns: calc(56 * var(--u)) 1fr auto calc(28 * var(--u));
    align-items: center;
    gap: calc(12 * var(--u));
    padding: calc(26 * var(--u)) calc(8 * var(--u));
    list-style: none;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .no {
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    color: #77756d;
    transition: color 0.2s;
  }
  details:hover .no,
  details[open] .no {
    color: var(--acid);
  }
  .title {
    min-width: 0;
  }
  .name {
    display: block;
    /* 行の高さに余裕を持たせる（1.1 だと、g や y の下のしっぽが切れる） */
    font: 600 clamp(1.25rem, 2.4vw, 2rem) / 1.4 var(--font-display);
    margin-block: -0.12em;
    letter-spacing: -0.04em;
    overflow-wrap: anywhere;
    transition: transform 0.4s var(--ease-out), color 0.2s;
  }
  details:hover .name {
    transform: translateX(calc(8 * var(--u)));
  }
  details[open] .name {
    color: var(--acid);
  }
  .meta-sp {
    display: none;
    margin-top: calc(6 * var(--u));
    font-size: 0.5625rem;
    letter-spacing: 0.08em;
    color: #77756d;
  }
  .meta-pc {
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    color: #77756d;
  }
  /* + が × に回る */
  .plus {
    position: relative;
    width: calc(18 * var(--u));
    height: calc(18 * var(--u));
    justify-self: end;
    transition: transform 0.4s var(--ease-out);
  }
  .plus::before,
  .plus::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: calc(1.5 * var(--u));
    background: currentColor;
  }
  .plus::after {
    transform: rotate(90deg);
  }
  details[open] .plus {
    transform: rotate(135deg);
    color: var(--coral);
  }

  .body {
    padding: calc(4 * var(--u)) calc(56 * var(--u)) calc(36 * var(--u)) calc(68 * var(--u));
  }
  .desc {
    /* カードの幅いっぱいに広げる（右側が空かないように） */
    font-size: 0.8125rem;
    line-height: 1.8;
    color: var(--muted);
  }
  .bullets {
    margin: calc(14 * var(--u)) 0 0;
    padding-left: calc(18 * var(--u));
    font-size: 0.8125rem;
    line-height: 1.8;
    color: var(--muted);
  }
  .shot {
    display: block;
    width: 100%;
    max-width: calc(640 * var(--u));
    height: auto;
    margin-top: calc(22 * var(--u));
    box-shadow: calc(10 * var(--u)) calc(10 * var(--u)) 0 var(--coral);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: calc(8 * var(--u));
    margin: calc(28 * var(--u)) 0 0;
    padding: 0;
    list-style: none;
  }
  .tags li {
    padding: calc(7 * var(--u)) calc(12 * var(--u));
    border: 1px solid var(--line);
    border-radius: calc(999 * var(--u));
    font-size: 0.5625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: calc(10 * var(--u));
    margin-top: calc(22 * var(--u));
  }
  .links a {
    padding: calc(12 * var(--u)) calc(20 * var(--u));
    border-radius: calc(999 * var(--u));
    background: var(--paper);
    color: var(--ink);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: background 0.25s, transform 0.25s;
  }
  /* コピーボタン：メールアドレスをクリップボードへ（押すと「コピーしました」に変わる） */
  .copy {
    padding: calc(12 * var(--u)) calc(20 * var(--u));
    border-radius: calc(999 * var(--u));
    background: var(--acid);
    color: var(--ink);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: background 0.25s, transform 0.25s;
  }
  .copy:hover {
    background: var(--paper);
    transform: translateY(calc(-2 * var(--u)));
  }
  .copy[data-copied] {
    background: var(--coral);
  }
  .links a:hover {
    background: var(--acid);
    transform: translateY(calc(-2 * var(--u)));
  }

  @media (max-width: 900px) {
    .meta-pc {
      display: none;
    }
    .meta-sp {
      display: block;
    }
    summary {
      grid-template-columns: calc(40 * var(--u)) 1fr calc(28 * var(--u));
    }
    .body {
      padding-left: calc(48 * var(--u));
    }
  }
  @media (max-width: 620px) {
    /* 開いた行の背景が付くので、文字やボタンが縁に張り付かないよう、左右に余白をとる（スマホの標準の余白 16px） */
    summary {
      padding: calc(22 * var(--u)) calc(16 * var(--u));
    }
    .body {
      padding: 0 calc(16 * var(--u)) calc(30 * var(--u));
    }
    .shot {
      box-shadow: calc(6 * var(--u)) calc(6 * var(--u)) 0 var(--coral);
    }
  }
</style>

<script>
  /**
   * トラックの開閉アニメーション。
   * <details> は高さをアニメーションできないので、Web Animations API で高さを動かす。
   * 1 つ開くと他は閉じる（排他）。JS が動かなくても <details> として普通に開閉できる。
   */
  const DURATION = 420;
  const EASE = 'cubic-bezier(0.22, 1, 0.36, 1)';
  const running = new WeakMap<HTMLDetailsElement, Animation[]>();

  const reduceMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /** 1 つのトラックを開く／閉じる（animate = false なら即座に切り替える） */
  function setOpen(details: HTMLDetailsElement, open: boolean, animate = true) {
    // 動作中のアニメーションがあれば止め、今の高さから続ける
    running.get(details)?.forEach((a) => a.cancel());
    const summary = details.querySelector('summary') as HTMLElement;
    const body = details.querySelector('[data-track-body]') as HTMLElement | null;
    const from = details.offsetHeight;

    if (!animate || reduceMotion()) {
      details.open = open;
      return;
    }

    if (open) details.open = true;
    // 閉じるときは閉じた状態の高さ（summary の高さ）まで縮める
    const to = open ? details.offsetHeight : summary.offsetHeight;

    details.style.overflow = 'hidden';
    const anims: Animation[] = [
      details.animate({ height: [`${from}px`, `${to}px`] }, { duration: DURATION, easing: EASE }),
    ];
    if (body) {
      anims.push(
        body.animate(
          open
            ? { opacity: [0, 1], transform: ['translateY(-8px)', 'translateY(0)'] }
            : { opacity: [1, 0], transform: ['translateY(0)', 'translateY(-8px)'] },
          { duration: DURATION * 0.8, easing: EASE, delay: open ? DURATION * 0.15 : 0, fill: 'both' },
        ),
      );
    }
    running.set(details, anims);

    anims[0].onfinish = () => {
      if (!open) details.open = false;
      details.style.overflow = '';
      anims.forEach((a) => a.cancel());
      running.delete(details);
    };
    // 途中で止められたとき（連打）はスタイルだけ戻す
    anims[0].oncancel = () => {
      details.style.overflow = '';
    };
  }

  /** 指定のトラックを開き、ほかを閉じる */
  function select(target: HTMLDetailsElement, animate = true) {
    document.querySelectorAll<HTMLDetailsElement>('details[data-track]').forEach((d) => {
      if (d !== target && d.open) setOpen(d, false, animate);
    });
    if (!target.open) setOpen(target, true, animate);
  }

  document.addEventListener('click', (e) => {
    const summary = (e.target as Element).closest('details[data-track] > summary');
    if (!summary) return;
    e.preventDefault();
    const details = summary.parentElement as HTMLDetailsElement;
    if (details.open) setOpen(details, false);
    else select(details);
  });

  // メールアドレスのコピー：押すとクリップボードに入れ、少しのあいだ「コピーしました」と出す
  document.addEventListener('click', async (e) => {
    const btn = (e.target as Element).closest<HTMLButtonElement>('button[data-copy]');
    if (!btn) return;
    const text = btn.dataset.copy ?? '';
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      // クリップボード API が使えない環境（古いブラウザ・http）では、選択してコピーする
      const area = document.createElement('textarea');
      area.value = text;
      area.style.position = 'fixed';
      area.style.opacity = '0';
      document.body.appendChild(area);
      area.select();
      document.execCommand('copy');
      area.remove();
    }
    const label = btn.querySelector('span')!;
    const original = btn.dataset.label ?? label.textContent ?? '';
    btn.dataset.label = original;
    label.textContent = btn.dataset.done ?? '';
    btn.setAttribute('data-copied', '');
    window.setTimeout(() => {
      label.textContent = original;
      btn.removeAttribute('data-copied');
    }, 1800);
  });

  // 再生ボタン：最初のトラックを開く。すでに開いていれば次のトラックへ進む
  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('[data-play]')) return;
    const tracks = [...document.querySelectorAll<HTMLDetailsElement>('details[data-track]')];
    if (!tracks.length) return;
    const current = tracks.findIndex((d) => d.open);
    const next = tracks[current < 0 ? 0 : (current + 1) % tracks.length];
    select(next);
    next.scrollIntoView({ behavior: reduceMotion() ? 'auto' : 'smooth', block: 'nearest' });
  });

  // #トラック名 つきの URL（または再生ボタン）で、その行を開く
  function openFromHash() {
    const id = decodeURIComponent(location.hash.slice(1));
    if (!id) return;
    const el = document.getElementById(id);
    if (el instanceof HTMLDetailsElement) select(el);
  }
  document.addEventListener('astro:page-load', openFromHash);
  openFromHash();
  window.addEventListener('hashchange', openFromHash);
</script>
