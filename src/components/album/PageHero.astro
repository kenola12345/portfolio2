---
/**
 * サブページ（アルバム・自己紹介）の先頭：大きなタイトル、紹介の 1 行、そして右側に
 * ジャケットと、その後ろから出てきて回り続けるレコード（中央のラベルは同じ画像）。
 * 色はページごとの accent。ボタンなどは slot に入れる。
 */
interface Props {
  /** 「ALBUM」「ARTIST」などの種別 */
  kicker: string;
  /** 「4 tracks」などの補足 */
  meta?: string;
  title: string;
  cover: string;
  accent: string;
  /** 見出しの番号（"01" など） */
  number?: string;
}

const { kicker, meta, title, cover, accent, number = '01' } = Astro.props;
---

<section class="page-hero" id="home" style={`--accent: ${accent}`}>
  <div class="copy">
    <p class="eyebrow" data-hero="line"><span>{number}</span> {kicker}{meta && ` / ${meta}`}</p>
    <h1 data-hero="line">{title}</h1>
    <div class="byline" data-hero="line"><slot name="byline" /></div>
    <div class="actions" data-hero="line"><slot /></div>
  </div>

  <div class="visual" aria-hidden="true">
    <!-- レコードは、位置とスライド（vinyl-slide）と、回転（vinyl-disc）を、別の要素で動かす -->
    <div class="vinyl-slide"><div class="vinyl-disc" style={`--cover: url(${cover})`}><span></span></div></div>
    <div class="sleeve"><img src={cover} alt="" width="768" height="768" /></div>
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: 4vw;
    padding: calc(80 * var(--u)) var(--gutter) calc(90 * var(--u));
    overflow: hidden;
    background:
      radial-gradient(circle at 78% 50%, color-mix(in srgb, var(--accent) 34%, transparent) 0%, transparent 38%),
      linear-gradient(115deg, var(--ink) 0 56%, var(--ink-2) 56%);
  }
  .page-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.12;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 120 120' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.35'/%3E%3C/svg%3E");
  }
  .copy {
    position: relative;
    z-index: 2;
    min-width: 0;
    container-type: inline-size;
  }
  .eyebrow {
    display: flex;
    gap: calc(18 * var(--u));
    align-items: center;
    text-transform: uppercase;
    font-size: 0.625rem;
    letter-spacing: 0.14em;
  }
  .eyebrow span {
    color: var(--accent);
    filter: brightness(1.4);
  }
  h1 {
    margin: 6vh 0 calc(28 * var(--u));
    font-family: var(--font-display);
    font-weight: 800;
    /* 文字の大きさは、左の列の幅に合わせる（最長の単語 "EXPERIENCE"（約 10.5em）が 1 行に収まる大きさ）。画面幅だと列の幅とずれて、途中で折り返してしまう */
    font-size: clamp(2rem, 9cqi, 6rem);
    letter-spacing: -0.07em;
    line-height: 0.86;
    text-transform: uppercase;
    overflow-wrap: break-word;
  }
  :global(html[lang='ja']) h1 {
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .byline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: calc(6 * var(--u)) calc(12 * var(--u));
    color: var(--muted);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }
  .byline :global(img) {
    width: calc(26 * var(--u));
    height: calc(26 * var(--u));
    border-radius: 50%;
    object-fit: cover;
  }
  .byline :global(a) {
    color: var(--paper);
  }
  .byline :global(a:hover) {
    color: var(--acid);
  }
  .actions {
    margin-top: calc(36 * var(--u));
  }

  /* ジャケットは正方形、レコードは同じ大きさの円（実物と同じ：ジャケットとレコードは同じ寸法）。
     レコードをジャケットの右から少し出して見せる。全体の高さ = ジャケットの高さ */
  .visual {
    position: relative;
    z-index: 1;
    width: min(100%, calc(520 * var(--u)));
    aspect-ratio: 1.32;
    justify-self: center;
  }
  .sleeve {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    width: 76%;
    aspect-ratio: 1;
    overflow: hidden;
    background: #1a1a17;
    box-shadow: calc(14 * var(--u)) calc(14 * var(--u)) 0 var(--accent);
    /* 傾いた状態から、まっすぐに回って収まる */
    transform-origin: 20% 90%;
    animation: sleeve-in 0.85s cubic-bezier(0.2, 0.9, 0.25, 1) both;
  }
  .sleeve img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .vinyl-slide {
    position: absolute;
    top: 1.5%;
    left: 25%;
    width: 73%;
    aspect-ratio: 1;
    /* ジャケットが傾きから戻り終わるころに、レコードがジャケットの後ろから滑り出てくる。終わりの位置が、いつもの表示 */
    /* 出だしを速く（イージングの最初の傾きを急にして）、そのあとゆっくり止まる */
    animation: disc-out 0.95s cubic-bezier(0.08, 0.9, 0.15, 1) 0.45s both;
  }
  .vinyl-disc {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: repeating-radial-gradient(circle, #161614 0 2px, #292925 3px, #111 5px);
    box-shadow: 0 calc(15 * var(--u)) calc(30 * var(--u)) #0006;
    animation: disc-spin 9s linear infinite;
  }
  .vinyl-disc span {
    width: 34%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--cover) center / cover;
    border: 5px solid var(--ink);
  }
  @keyframes sleeve-in {
    from {
      opacity: 0;
      transform: rotate(-16deg) translateY(calc(28 * var(--u))) scale(0.94);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  /* 最初は透明（ジャケットがふわっと出てくる間に、後ろのレコードが透けて見えないように）。
     動き始めたら、すぐに見えるようになる */
  @keyframes disc-out {
    from {
      opacity: 0;
      /* ジャケットの後ろに、ほぼ全部隠れている（自分の幅の約 34% 左） */
      transform: translateX(-34%);
    }
    12% {
      opacity: 1;
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  /* ワイプで移動してきたときは、ワイプが上へ抜けてから始める */
  :global(html[data-wipe-arrive]) .sleeve {
    animation-delay: 0.45s;
  }
  :global(html[data-wipe-arrive]) .vinyl-slide {
    animation-delay: 0.9s;
  }
  @keyframes disc-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (max-width: 900px) {
    .page-hero {
      grid-template-columns: 1fr;
      padding: calc(56 * var(--u)) var(--gutter) calc(70 * var(--u));
      gap: calc(56 * var(--u));
    }
    h1 {
      margin-top: calc(40 * var(--u));
    }
    .visual {
      width: min(94%, calc(440 * var(--u)));
    }
  }
  @media (max-width: 620px) {
    .page-hero {
      padding-inline: calc(20 * var(--u));
    }
    h1 {
      letter-spacing: -0.06em;
    }
    :global(html[lang='ja']) h1 {
      font-size: 11vw;
    }
  }
</style>
