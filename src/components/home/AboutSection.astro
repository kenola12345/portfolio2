---
/**
 * 自己紹介：左にアーケード風のパネル、右に見出し・紹介文・スキルの一覧。
 * 紹介文はアーティストデータの bio をそのまま使う。
 */
import ArcadePanel from './ArcadePanel.astro';
import SkillRows from './SkillRows.astro';
import ArrowIcon from './ArrowIcon.astro';
import { artist } from '../../data/artist';
import { home } from '../../data/home';
import { getLang, localePath, useT } from '../../lib/i18n';

const t = useT(Astro.url);
const lang = getLang(Astro.url);
---

<section class="about" id="about">
  <ArcadePanel />

  <div class="about-copy">
    <p class="eyebrow" data-reveal><span>03</span> {t(home.about.eyebrow)}</p>
    <h2 data-reveal>{t(home.about.title)}<br /><i>{t(home.about.titleAccent)}</i></h2>
    <p class="about-lead" data-reveal>{t(artist.bio)}</p>
    <SkillRows />
    <a class="full-story" href={localePath('/artist', lang)} data-reveal>
      {t(home.about.more)} <ArrowIcon />
    </a>
  </div>
</section>

<style>
  .about {
    position: relative;
    min-height: calc(850 * var(--u));
    padding: calc(120 * var(--u)) var(--gutter);
    display: grid;
    grid-template-columns: 45% 55%;
    overflow: hidden;
    background: var(--ink-2);
  }
  .about::before {
    content: '';
    position: absolute;
    left: calc(-280 * var(--u));
    top: calc(100 * var(--u));
    width: calc(600 * var(--u));
    height: calc(600 * var(--u));
    border: 1px solid #b8ff3517;
    border-radius: 50%;
    box-shadow:
      0 0 0 calc(100 * var(--u)) #b8ff3508,
      0 0 0 calc(200 * var(--u)) #b8ff3505;
  }
  .about-copy {
    z-index: 1;
    padding-left: 6vw;
  }
  .eyebrow {
    display: flex;
    gap: calc(18 * var(--u));
    align-items: center;
    text-transform: uppercase;
    font-size: 0.625rem;
    letter-spacing: 0.14em;
  }
  .eyebrow span {
    color: var(--acid);
  }
  h2 {
    margin-top: calc(35 * var(--u));
    font-family: var(--font-display);
    font-weight: 800;
    /* 右の列は幅が狭いので、他の見出しより少し小さくして、はみ出さないようにする */
    font-size: clamp(3.125rem, 6.4vw, 6.25rem);
    letter-spacing: -0.075em;
    line-height: 0.82;
  }
  h2 i {
    color: var(--acid);
    font-style: normal;
  }
  .about-lead {
    max-width: calc(590 * var(--u));
    margin: calc(50 * var(--u)) 0;
    font-size: 0.875rem;
    line-height: 1.8;
    color: #aaa79e;
  }
  .full-story {
    display: inline-flex;
    align-items: center;
    gap: calc(10 * var(--u));
    margin-top: calc(40 * var(--u));
    padding: calc(12 * var(--u)) calc(20 * var(--u));
    border: 1px solid var(--line);
    border-radius: calc(999 * var(--u));
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: background 0.25s, color 0.25s, border-color 0.25s;
  }
  .full-story :global(svg) {
    width: calc(14 * var(--u));
  }
  .full-story:hover {
    background: var(--acid);
    border-color: var(--acid);
    color: var(--ink);
  }
  @media (max-width: 900px) {
    .about {
      grid-template-columns: 1fr;
    }
    .about-copy {
      padding-left: 0;
    }
  }
  @media (max-width: 620px) {
    .about {
      padding: calc(85 * var(--u)) calc(20 * var(--u));
    }
    h2 {
      /* 「FEATURED」などの 8 文字が 1 行に収まる大きさ */
      font-size: 12vw;
      letter-spacing: -0.06em;
    }
  }
</style>
