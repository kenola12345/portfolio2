---
/**
 * アーケード筐体風のパネル（飾り）。「スタートで一緒に作ろう」を押すと連絡先へ移動する。
 */
import { home } from '../../data/home';
import { useT } from '../../lib/i18n';

const t = useT(Astro.url);
---

<div
  class="arcade-panel"
  data-reveal
  data-lives={t(home.arcade.lives)}
  data-win={t(home.arcade.win)}
  data-over={t(home.arcade.over)}
  data-time={t(home.arcade.time)}
  data-saving={t(home.arcade.saving)}
  data-save={t(home.arcade.save)}
  data-save-error={t(home.arcade.saveError)}
  data-loading={t(home.arcade.loading)}
  data-empty={t(home.arcade.empty)}
  data-load-error={t(home.arcade.loadError)}
>
  <!-- 画面をクリック（または Enter）でゲーム開始 -->
  <div class="screen" role="button" tabindex="0" aria-label={t(home.arcade.play)} data-arcade-screen>
    <div class="attract" data-attract>
      <!-- 見本：ステージに 2 人のキャラ（本番と同じ絵）。遊べるゲームだと一目で分かるように -->
      <canvas class="preview" data-preview aria-hidden="true"></canvas>
      <button type="button" class="board-open" data-board-open hidden>{t(home.arcade.showBoard)}</button>
      <!-- 目立たせたいので、ボタンの形にして、光の輪が広がり続ける -->
      <span class="cta">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z" /></svg>
        {t(home.arcade.play)}
      </span>
    </div>

    <div class="stage" data-stage hidden>
      <canvas data-canvas aria-label="Platformer game"></canvas>
      <p class="hud"><span data-hud-score>SCORE 000000</span><span data-hud-lives></span></p>
      <p class="hint hint-keys">{t(home.arcade.controlsKeys)}</p>
      <p class="hint hint-touch">{t(home.arcade.controlsTouch)}</p>
      <button type="button" class="sound" data-sound aria-pressed="false" aria-label={t(home.arcade.sound)}>♪</button>
      <button type="button" class="exit" data-exit aria-label={t(home.arcade.exit)}>✕</button>

      <!-- クリア・ゲームオーバーの表示 -->
      <div class="result" data-result hidden>
        <strong data-result-title></strong>
        <span data-result-score></span>
        <!-- 勝ったときだけ：名前を入れてランキングに登録 -->
        <form class="entry" data-entry hidden>
          <label for="arcade-name">{t(home.arcade.enterName)}</label>
          <input id="arcade-name" type="text" maxlength="12" autocomplete="nickname" autocapitalize="characters" spellcheck="false" data-name />
          <p class="error" data-entry-error role="alert" hidden>{t(home.arcade.saveError)}</p>
          <div class="row">
            <button type="submit" data-save>{t(home.arcade.save)}</button>
            <button type="button" data-skip>{t(home.arcade.skip)}</button>
          </div>
        </form>
        <div class="row" data-result-actions>
          <button type="button" data-again>{t(home.arcade.again)}</button>
          <button type="button" data-board-open-result hidden>{t(home.arcade.showBoard)}</button>
        </div>
        <a href="#contact" data-collab>{t(home.arcade.start)} ↗</a>
      </div>
    </div>

    <!-- ランキング（スタート画面からも、クリア後にも開ける） -->
    <div class="board" data-board hidden role="dialog" aria-modal="true" aria-labelledby="arcade-board-title">
      <strong id="arcade-board-title">{t(home.arcade.boardTitle)}</strong>
      <p class="board-note" data-board-note role="status"></p>
      <ol class="board-list" data-board-list></ol>
      <button type="button" class="board-close" data-board-close>{t(home.arcade.close)}</button>
    </div>
  </div>
  <!-- 筐体のスティックとボタンが、そのまま操作になる（左右・ジャンプ / 強攻撃 / 弱攻撃）。マウスでも指でも動く -->
  <div class="controls">
    <div class="stick" data-stick role="group" aria-label={t(home.arcade.stick)}></div>
    <button type="button" class="btn heavy" data-key="heavy" aria-label={t(home.arcade.heavy)}></button>
    <button type="button" class="btn light" data-key="light" aria-label={t(home.arcade.light)}></button>
  </div>
</div>

<script>
  import { createGame, type Game, type InputKey } from './arcade-game';
  import { isMuted, play, setMuted, unlockAudio } from './arcade-sound';
  import { cleanName, leaderboardEnabled, submitScore, topEntries, type Entry } from '../../lib/leaderboard';

  const panel = document.querySelector<HTMLElement>('.arcade-panel');
  const screen = panel?.querySelector<HTMLElement>('[data-arcade-screen]');
  const attract = panel?.querySelector<HTMLElement>('[data-attract]');
  const stage = panel?.querySelector<HTMLElement>('[data-stage]');
  const canvas = panel?.querySelector<HTMLCanvasElement>('[data-canvas]');
  const result = panel?.querySelector<HTMLElement>('[data-result]');

  if (panel && screen && attract && stage && canvas && result) {
    const hudScore = panel.querySelector<HTMLElement>('[data-hud-score]')!;
    const hudLives = panel.querySelector<HTMLElement>('[data-hud-lives]')!;
    const resultTitle = panel.querySelector<HTMLElement>('[data-result-title]')!;
    const resultScore = panel.querySelector<HTMLElement>('[data-result-score]')!;
    const KEYS: Record<string, InputKey> = {
      ArrowLeft: 'left',
      a: 'left',
      A: 'left',
      ArrowRight: 'right',
      d: 'right',
      D: 'right',
      ArrowUp: 'jump',
      ArrowDown: 'down',
      s: 'down',
      S: 'down',
      w: 'jump',
      W: 'jump',
      ' ': 'jump',
      j: 'light',
      J: 'light',
      z: 'light',
      Z: 'light',
      k: 'heavy',
      K: 'heavy',
      x: 'heavy',
      X: 'heavy',
    };
    const ALL_KEYS: InputKey[] = ['left', 'right', 'jump', 'down', 'light', 'heavy'];

    // 開始前の見本の絵（フォントが読み込まれてから描く）
    const previewCanvas = panel.querySelector<HTMLCanvasElement>('[data-preview]');
    const previewGame = previewCanvas ? createGame(previewCanvas, { onEnd: () => {} }) : null;
    const drawPreview = () => previewGame?.preview();
    void document.fonts.ready.then(drawPreview);

    let game: Game | null = null;
    let playing = false;

    // ---- ランキング ----
    const entryForm = panel.querySelector<HTMLFormElement>('[data-entry]')!;
    const nameInput = panel.querySelector<HTMLInputElement>('[data-name]')!;
    const saveBtn = panel.querySelector<HTMLButtonElement>('[data-save]')!;
    const entryError = panel.querySelector<HTMLElement>('[data-entry-error]')!;
    const resultActions = panel.querySelector<HTMLElement>('[data-result-actions]')!;
    const board = panel.querySelector<HTMLElement>('[data-board]')!;
    const boardList = panel.querySelector<HTMLElement>('[data-board-list]')!;
    const boardNote = panel.querySelector<HTMLElement>('[data-board-note]')!;
    const boardOpeners = panel.querySelectorAll<HTMLElement>('[data-board-open], [data-board-open-result]');
    let pending: Entry | null = null;
    let boardReturn: HTMLElement | null = null;
    let lastSaved: Entry | null = null;

    const enabled = leaderboardEnabled();
    boardOpeners.forEach((b) => (b.hidden = !enabled));

    // 表示はすべて textContent（名前は他の人が入れた文字なので、HTML として扱わない）
    const renderBoard = (rows: Entry[]) => {
      boardList.replaceChildren();
      let mine = lastSaved ? rows.findIndex((r) => r.name === lastSaved!.name && r.score === lastSaved!.score && r.timeMs === lastSaved!.timeMs) : -1;
      rows.forEach((r, i) => {
        const li = document.createElement('li');
        if (i === mine) li.className = 'me';
        const cells = [String(i + 1), r.name, pad(r.score), fmtTime(r.timeMs)];
        cells.forEach((text, c) => {
          const span = document.createElement('span');
          span.textContent = text;
          span.className = ['rank', 'who', 'pts', 'clock'][c];
          li.append(span);
        });
        boardList.append(li);
      });
    };

    async function openBoard(from: HTMLElement | null) {
      boardReturn = from;
      board.hidden = false;
      boardList.replaceChildren();
      boardNote.textContent = panel!.dataset.loading!;
      board.querySelector<HTMLElement>('[data-board-close]')?.focus();
      try {
        const rows = await topEntries(10);
        if (board.hidden) return;
        boardNote.textContent = rows.length ? '' : panel!.dataset.empty!;
        renderBoard(rows);
      } catch {
        if (!board.hidden) boardNote.textContent = panel!.dataset.loadError!;
      }
    }
    function closeBoard() {
      board.hidden = true;
      (boardReturn ?? screen)!.focus({ preventScroll: true });
    }
    boardOpeners.forEach((b) =>
      b.addEventListener('click', (e) => {
        e.stopPropagation();
        void openBoard(b);
      }),
    );
    board.querySelector('[data-board-close]')?.addEventListener('click', (e) => {
      e.stopPropagation();
      closeBoard();
    });
    // 画面全体が「クリックで開始」なので、ランキングの中のクリックは外へ伝えない
    board.addEventListener('click', (e) => e.stopPropagation());
    entryForm.addEventListener('click', (e) => e.stopPropagation());

    const finishEntry = () => {
      entryForm.hidden = true;
      resultActions.hidden = false;
      panel!.querySelector<HTMLElement>('[data-again]')?.focus();
    };
    entryForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = cleanName(nameInput.value);
      if (!pending || !name) {
        nameInput.focus();
        return;
      }
      saveBtn.disabled = true;
      saveBtn.textContent = panel!.dataset.saving!;
      entryError.hidden = true;
      try {
        await submitScore({ ...pending, name });
        lastSaved = { ...pending, name };
        pending = null;
        try {
          localStorage.setItem('arcade-name', name);
        } catch {}
        finishEntry();
        void openBoard(panel!.querySelector<HTMLElement>('[data-again]'));
      } catch {
        entryError.hidden = false;
        saveBtn.disabled = false;
        saveBtn.textContent = panel!.dataset.save!;
      }
    });
    panel.querySelector('[data-skip]')?.addEventListener('click', () => {
      pending = null;
      finishEntry();
    });

    const pad = (n: number) => String(n).padStart(6, '0');
    /** ミリ秒を「1:23.4」の形に */
    const fmtTime = (ms: number) => {
      const t = Math.round(ms / 100) / 10;
      const m = Math.floor(t / 60);
      return `${m}:${(t - m * 60).toFixed(1).padStart(4, '0')}`;
    };
    const setHud = (score: number, lives: number) => {
      hudScore.textContent = `SCORE ${pad(score)}`;
      hudLives.textContent = `${panel.dataset.lives} ${'♥'.repeat(Math.max(lives, 0))}`;
    };

    function begin() {
      unlockAudio(); // 音は、クリックなどの操作の中でないと出せない
      game ??= createGame(canvas!, {
        onHud: setHud,
        onSound: play,
        onEnd: (kind: 'won' | 'over', score: number, timeMs: number) => {
          resultTitle.textContent = kind === 'won' ? panel!.dataset.win! : panel!.dataset.over!;
          resultScore.textContent =
            kind === 'won' ? `SCORE ${pad(score)} · ${panel!.dataset.time} ${fmtTime(timeMs)}` : `SCORE ${pad(score)}`;
          result!.hidden = false;
          // 勝ったら、名前を入れてランキングに登録できる（登録するか、やめるまで、次の操作は出さない）
          if (kind === 'won' && leaderboardEnabled()) {
            pending = { name: '', score, timeMs };
            entryForm.hidden = false;
            resultActions.hidden = true;
            entryError.hidden = true;
            saveBtn.disabled = false;
            saveBtn.textContent = panel!.dataset.save!;
            try {
              nameInput.value = localStorage.getItem('arcade-name') ?? '';
            } catch {
              nameInput.value = '';
            }
            nameInput.focus();
            nameInput.select();
          } else {
            panel!.querySelector<HTMLElement>('[data-again]')?.focus();
          }
        },
      });
      result!.hidden = true;
      board.hidden = true;
      entryForm.hidden = true;
      resultActions.hidden = false;
      pending = null;
      attract!.hidden = true;
      stage!.hidden = false;
      screen!.removeAttribute('role');
      playing = true;
      game.start();
    }

    function end() {
      game?.stop();
      playing = false;
      stage!.hidden = true;
      result!.hidden = true;
      board.hidden = true;
      entryForm.hidden = true;
      resultActions.hidden = false;
      pending = null;
      attract!.hidden = false;
      screen!.setAttribute('role', 'button');
      drawPreview();
      screen!.focus({ preventScroll: true });
    }

    // 画面をクリック／Enter で開始（ゲーム中のクリックは何もしない）
    screen.addEventListener('click', (e) => {
      if (playing) return;
      e.preventDefault();
      begin();
    });
    screen.addEventListener('keydown', (e) => {
      if (!playing && (e.key === 'Enter' || e.key === ' ') && e.target === screen) {
        e.preventDefault();
        begin();
      }
    });
    const soundBtn = panel.querySelector<HTMLElement>('[data-sound]')!;
    const showSound = () => {
      soundBtn.classList.toggle('off', isMuted());
      soundBtn.setAttribute('aria-pressed', String(!isMuted()));
    };
    showSound();
    soundBtn.addEventListener('click', () => {
      setMuted(!isMuted());
      showSound();
    });
    // 終了ボタンのクリックが、下の画面（クリックで開始）へ伝わって、すぐ再開してしまわないように止める
    panel.querySelector('[data-exit]')?.addEventListener('click', (e) => {
      e.stopPropagation();
      end();
    });
    panel.querySelector('[data-again]')?.addEventListener('click', begin);
    // 「一緒に作ろう」のリンクを押したら、ゲームは終わらせて連絡先へ
    panel.querySelector('[data-collab]')?.addEventListener('click', (e) => {
      e.stopPropagation();
      end();
    });

    // キーボード：ゲーム中だけ。矢印・スペースでページがスクロールしないようにする
    const onKey = (down: boolean) => (e: KeyboardEvent) => {
      if (!board.hidden) {
        if (e.key === 'Escape' && down) closeBoard();
        return;
      }
      // 名前を入力しているあいだは、ゲームのキーとして扱わない（文字がそのまま入る）
      if (!playing || e.target instanceof HTMLInputElement) return;
      if (e.key === 'Escape' && down) {
        end();
        return;
      }
      const key = KEYS[e.key];
      if (!key) return;
      e.preventDefault();
      game?.setInput(key, down);
    };
    window.addEventListener('keydown', onKey(true));
    window.addEventListener('keyup', onKey(false));
    window.addEventListener('blur', () => ALL_KEYS.forEach((k) => game?.setInput(k, false)));

    // スティックやボタンを押さえているあいだは、指を上下に動かしてもページがスクロールしないようにする。
    // iOS では touch-action だけだと効かないことがあるので、touchmove を止める（押さえている間だけ登録する）
    const blockScroll = (e: TouchEvent) => {
      if (e.cancelable) e.preventDefault();
    };
    let holds = 0;
    // 指が離れたのに pointerup が届かなかったときの保険：すべての指が離れたら、全部の「押さえている」を解く
    const releasers: (() => void)[] = [];
    const releaseAll = (e: TouchEvent) => {
      if (e.touches.length === 0) releasers.forEach((fn) => fn());
    };
    document.addEventListener('touchend', releaseAll);
    document.addEventListener('touchcancel', releaseAll);
    const hold = (on: boolean) => {
      holds = Math.max(0, holds + (on ? 1 : -1));
      if (on && holds === 1) document.addEventListener('touchmove', blockScroll, { passive: false });
      if (!on && holds === 0) document.removeEventListener('touchmove', blockScroll);
    };

    // 筐体のボタン（赤 = 強、緑 = 弱）：押している間だけ入力。ゲーム中でなければ何もしない
    panel.querySelectorAll<HTMLElement>('[data-key]').forEach((btn) => {
      const key = btn.dataset.key as InputKey;
      let held = false;
      const set = (down: boolean) => (e: Event) => {
        e.preventDefault();
        btn.classList.toggle('pressed', down);
        game?.setInput(key, down);
        if (down !== held) {
          held = down;
          hold(down);
        }
      };
      releasers.push(() => {
        if (held) set(false)(new Event('release'));
      });
      btn.addEventListener('pointerdown', set(true));
      btn.addEventListener('pointerup', set(false));
      btn.addEventListener('pointercancel', set(false));
      btn.addEventListener('pointerleave', set(false));
      btn.addEventListener('contextmenu', (e) => e.preventDefault());
    });

    // 筐体のスティック：左右に倒すと移動、上に倒すとジャンプ。倒した向きにレバーが傾く
    const stick = panel.querySelector<HTMLElement>('[data-stick]');
    if (stick) {
      const apply = (e: PointerEvent) => {
        const r = stick.getBoundingClientRect();
        const dx = e.clientX - (r.left + r.width / 2);
        const dy = e.clientY - (r.top + r.height / 2);
        const dead = r.width * 0.16;
        game?.setInput('left', dx < -dead);
        game?.setInput('right', dx > dead);
        game?.setInput('jump', dy < -r.height * 0.28);
        game?.setInput('down', dy > r.height * 0.28);
        const tilt = Math.max(-1, Math.min(1, dx / (r.width / 2))) * 28;
        stick.style.setProperty('--tilt', `${tilt}deg`);
      };
      let stickHeld = false;
      const release = () => {
        (['left', 'right', 'jump', 'down'] as const).forEach((k) => game?.setInput(k, false));
        stick.style.setProperty('--tilt', '0deg');
        if (stickHeld) {
          stickHeld = false;
          hold(false);
        }
      };
      stick.addEventListener('pointerdown', (e) => {
        e.preventDefault();
        if (!stickHeld) {
          stickHeld = true;
          hold(true);
        }
        stick.setPointerCapture(e.pointerId);
        apply(e);
      });
      stick.addEventListener('pointermove', (e) => {
        if (stick.hasPointerCapture(e.pointerId)) apply(e);
      });
      releasers.push(release);
      stick.addEventListener('lostpointercapture', release);
      stick.addEventListener('pointerup', release);
      stick.addEventListener('pointercancel', release);
      stick.addEventListener('contextmenu', (e) => e.preventDefault());
    }

    // 画面から外れたり、タブが隠れたら一時停止
    const pause = (p: boolean) => playing && game?.setPaused(p);
    new IntersectionObserver(([entry]) => pause(!entry.isIntersecting), { threshold: 0.2 }).observe(screen);
    document.addEventListener('visibilitychange', () => pause(document.hidden));
  }
</script>

<style>
  .arcade-panel {
    z-index: 1;
    width: min(calc(430 * var(--u)), 90%);
    height: calc(580 * var(--u));
    margin: calc(85 * var(--u)) auto 0;
    padding: calc(34 * var(--u));
    background: #ddd8ca;
    transform: perspective(calc(1000 * var(--u))) rotateY(7deg);
    box-shadow: calc(-25 * var(--u)) calc(25 * var(--u)) 0 #090908;
  }
  .screen {
    position: relative;
    display: block;
    cursor: pointer;
    overflow: hidden;
    height: calc(370 * var(--u));
    padding: calc(20 * var(--u));
    border: 12px solid #2c2c27;
    background-color: #151c18;
    background-image: repeating-linear-gradient(0deg, transparent 0 4px, #b8ff3509 5px);
    box-shadow: inset 0 0 calc(70 * var(--u)) #b8ff3512;
    color: var(--acid);
    text-align: center;
  }
  .screen:focus-visible {
    outline: 2px solid var(--acid);
    outline-offset: 4px;
  }
  .attract[hidden],
  .stage[hidden],
  .result[hidden],
  .board[hidden],
  .entry[hidden],
  .board-open[hidden],
  [data-board-open-result][hidden],
  .result .row[hidden],
  .error[hidden] {
    display: none;
  }
  .screen-score {
    position: absolute;
    top: calc(17 * var(--u));
    left: calc(17 * var(--u));
    font-size: 0.5rem;
    letter-spacing: 0.15em;
  }
  .attract {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: calc(34 * var(--u)) calc(16 * var(--u)) calc(26 * var(--u));
  }
  /* 見本のステージ：画面いっぱいに、ドットのまま拡大して敷く */
  .preview {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 100%;
    height: auto;
    max-height: 100%;
    aspect-ratio: 1;
    image-rendering: pixelated;
  }
  /* 「クリックで遊べる」ことが分かるように、大きなボタンにして、光の輪を広げ続ける */
  .cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: calc(10 * var(--u));
    padding: calc(12 * var(--u)) calc(22 * var(--u));
    border-radius: 999px;
    background: var(--acid);
    color: var(--ink);
    font: 700 0.8125rem var(--font-mono);
    letter-spacing: 0.14em;
    animation: cta-pulse 1.6s ease-out infinite;
  }
  .screen:hover .cta {
    background: var(--paper);
  }
  @keyframes cta-pulse {
    0% {
      box-shadow: 0 0 0 0 #b8ff35cc;
      transform: scale(1);
    }
    55% {
      box-shadow: 0 0 0 calc(14 * var(--u)) #b8ff3500;
      transform: scale(1.04);
    }
    100% {
      box-shadow: 0 0 0 0 #b8ff3500;
      transform: scale(1);
    }
  }
  /* ゲーム中の画面：canvas は正方形（240×240）をドットのまま拡大する */
  .stage {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    cursor: default;
    touch-action: none;
  }
  /* 画面（正方形でなくてもよい）の中に、正方形のステージがはみ出さずに収まる大きさで置く。
     スマホでは画面が縦長になるので、高さではなく幅に合わせる */
  canvas {
    display: block;
    width: 100%;
    height: auto;
    max-height: 100%;
    aspect-ratio: 1;
    margin: auto;
    image-rendering: pixelated;
  }
  .hud {
    position: absolute;
    top: calc(8 * var(--u));
    left: calc(10 * var(--u));
    right: calc(62 * var(--u));
    display: flex;
    justify-content: space-between;
    font-size: 0.5rem;
    letter-spacing: 0.12em;
  }
  .hint {
    position: absolute;
    bottom: calc(8 * var(--u));
    left: 0;
    right: 0;
    text-align: center;
    font-size: 0.4375rem;
    letter-spacing: 0.1em;
    opacity: 0.7;
  }
  .sound {
    position: absolute;
    top: calc(4 * var(--u));
    right: calc(32 * var(--u));
