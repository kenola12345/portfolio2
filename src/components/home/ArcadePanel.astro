---
/**
 * アーケード筐体風のパネル（飾り）。「スタートで一緒に作ろう」を押すと連絡先へ移動する。
 */
import { home } from '../../data/home';
import { useT } from '../../lib/i18n';

const t = useT(Astro.url);
const title = t(home.arcade.title).split('\n');
---

<div
  class="arcade-panel"
  data-reveal
  data-lives={t(home.arcade.lives)}
  data-win={t(home.arcade.win)}
  data-over={t(home.arcade.over)}
>
  <!-- 画面をクリック（または Enter）でゲーム開始 -->
  <div class="screen" role="button" tabindex="0" aria-label={t(home.arcade.play)} data-arcade-screen>
    <div class="attract" data-attract>
      <span class="screen-score">{t(home.arcade.score)}</span>
      <div class="space-invader" aria-hidden="true">
        {Array.from({ length: 15 }, () => <i />)}
      </div>
      <strong>{title[0]}<br />{title[1]}</strong>
      <small>{t(home.arcade.play)}</small>
    </div>

    <div class="stage" data-stage hidden>
      <canvas data-canvas aria-label="Platformer game"></canvas>
      <p class="hud"><span data-hud-score>SCORE 000000</span><span data-hud-lives></span></p>
      <p class="hint hint-keys">{t(home.arcade.controlsKeys)}</p>
      <p class="hint hint-touch">{t(home.arcade.controlsTouch)}</p>
      <button type="button" class="sound" data-sound aria-pressed="false" aria-label={t(home.arcade.sound)}>♪</button>
      <button type="button" class="exit" data-exit aria-label={t(home.arcade.exit)}>✕</button>

      <!-- クリア・ゲームオーバーの表示 -->
      <div class="result" data-result hidden>
        <strong data-result-title></strong>
        <span data-result-score></span>
        <button type="button" data-again>{t(home.arcade.again)}</button>
        <a href="#contact" data-collab>{t(home.arcade.start)} ↗</a>
      </div>
    </div>
  </div>
  <!-- 筐体のスティックとボタンが、そのまま操作になる（左右・ジャンプ / 強攻撃 / 弱攻撃）。マウスでも指でも動く -->
  <div class="controls">
    <div class="stick" data-stick role="group" aria-label={t(home.arcade.stick)}></div>
    <button type="button" class="btn heavy" data-key="heavy" aria-label={t(home.arcade.heavy)}></button>
    <button type="button" class="btn light" data-key="light" aria-label={t(home.arcade.light)}></button>
  </div>
</div>

<script>
  import { createGame, type Game, type InputKey } from './arcade-game';
  import { isMuted, play, setMuted, unlockAudio } from './arcade-sound';

  const panel = document.querySelector<HTMLElement>('.arcade-panel');
  const screen = panel?.querySelector<HTMLElement>('[data-arcade-screen]');
  const attract = panel?.querySelector<HTMLElement>('[data-attract]');
  const stage = panel?.querySelector<HTMLElement>('[data-stage]');
  const canvas = panel?.querySelector<HTMLCanvasElement>('[data-canvas]');
  const result = panel?.querySelector<HTMLElement>('[data-result]');

  if (panel && screen && attract && stage && canvas && result) {
    const hudScore = panel.querySelector<HTMLElement>('[data-hud-score]')!;
    const hudLives = panel.querySelector<HTMLElement>('[data-hud-lives]')!;
    const resultTitle = panel.querySelector<HTMLElement>('[data-result-title]')!;
    const resultScore = panel.querySelector<HTMLElement>('[data-result-score]')!;
    const KEYS: Record<string, InputKey> = {
      ArrowLeft: 'left',
      a: 'left',
      A: 'left',
      ArrowRight: 'right',
      d: 'right',
      D: 'right',
      ArrowUp: 'jump',
      w: 'jump',
      W: 'jump',
      ' ': 'jump',
      j: 'light',
      J: 'light',
      z: 'light',
      Z: 'light',
      k: 'heavy',
      K: 'heavy',
      x: 'heavy',
      X: 'heavy',
    };
    const ALL_KEYS: InputKey[] = ['left', 'right', 'jump', 'light', 'heavy'];

    let game: Game | null = null;
    let playing = false;

    const pad = (n: number) => String(n).padStart(6, '0');
    const setHud = (score: number, lives: number) => {
      hudScore.textContent = `SCORE ${pad(score)}`;
      hudLives.textContent = `${panel.dataset.lives} ${'♥'.repeat(Math.max(lives, 0))}`;
    };

    function begin() {
      unlockAudio(); // 音は、クリックなどの操作の中でないと出せない
      game ??= createGame(canvas!, {
        onHud: setHud,
        onSound: play,
        onEnd: (kind, score) => {
          resultTitle.textContent = kind === 'won' ? panel!.dataset.win! : panel!.dataset.over!;
          resultScore.textContent = `SCORE ${pad(score)}`;
          result!.hidden = false;
          panel!.querySelector<HTMLElement>('[data-again]')?.focus();
        },
      });
      result!.hidden = true;
      attract!.hidden = true;
      stage!.hidden = false;
      screen!.removeAttribute('role');
      playing = true;
      game.start();
    }

    function end() {
      game?.stop();
      playing = false;
      stage!.hidden = true;
      result!.hidden = true;
      attract!.hidden = false;
      screen!.setAttribute('role', 'button');
      screen!.focus({ preventScroll: true });
    }

    // 画面をクリック／Enter で開始（ゲーム中のクリックは何もしない）
    screen.addEventListener('click', (e) => {
      if (playing) return;
      e.preventDefault();
      begin();
    });
    screen.addEventListener('keydown', (e) => {
      if (!playing && (e.key === 'Enter' || e.key === ' ') && e.target === screen) {
        e.preventDefault();
        begin();
      }
    });
    const soundBtn = panel.querySelector<HTMLElement>('[data-sound]')!;
    const showSound = () => {
      soundBtn.classList.toggle('off', isMuted());
      soundBtn.setAttribute('aria-pressed', String(!isMuted()));
    };
    showSound();
    soundBtn.addEventListener('click', () => {
      setMuted(!isMuted());
      showSound();
    });
    panel.querySelector('[data-exit]')?.addEventListener('click', end);
    panel.querySelector('[data-again]')?.addEventListener('click', begin);
    // 「一緒に作ろう」のリンクを押したら、ゲームは終わらせて連絡先へ
    panel.querySelector('[data-collab]')?.addEventListener('click', end);

    // キーボード：ゲーム中だけ。矢印・スペースでページがスクロールしないようにする
    const onKey = (down: boolean) => (e: KeyboardEvent) => {
      if (!playing) return;
      if (e.key === 'Escape' && down) {
        end();
        return;
      }
      const key = KEYS[e.key];
      if (!key) return;
      e.preventDefault();
      game?.setInput(key, down);
    };
    window.addEventListener('keydown', onKey(true));
    window.addEventListener('keyup', onKey(false));
    window.addEventListener('blur', () => ALL_KEYS.forEach((k) => game?.setInput(k, false)));

    // 筐体のボタン（赤 = 強、緑 = 弱）：押している間だけ入力。ゲーム中でなければ何もしない
    panel.querySelectorAll<HTMLElement>('[data-key]').forEach((btn) => {
      const key = btn.dataset.key as InputKey;
      const set = (down: boolean) => (e: Event) => {
        e.preventDefault();
        btn.classList.toggle('pressed', down);
        game?.setInput(key, down);
      };
      btn.addEventListener('pointerdown', set(true));
      btn.addEventListener('pointerup', set(false));
      btn.addEventListener('pointercancel', set(false));
      btn.addEventListener('pointerleave', set(false));
      btn.addEventListener('contextmenu', (e) => e.preventDefault());
    });

    // 筐体のスティック：左右に倒すと移動、上に倒すとジャンプ。倒した向きにレバーが傾く
    const stick = panel.querySelector<HTMLElement>('[data-stick]');
    if (stick) {
      const apply = (e: PointerEvent) => {
        const r = stick.getBoundingClientRect();
        const dx = e.clientX - (r.left + r.width / 2);
        const dy = e.clientY - (r.top + r.height / 2);
        const dead = r.width * 0.16;
        game?.setInput('left', dx < -dead);
        game?.setInput('right', dx > dead);
        game?.setInput('jump', dy < -r.height * 0.28);
        const tilt = Math.max(-1, Math.min(1, dx / (r.width / 2))) * 28;
        stick.style.setProperty('--tilt', `${tilt}deg`);
      };
      const release = () => {
        (['left', 'right', 'jump'] as const).forEach((k) => game?.setInput(k, false));
        stick.style.setProperty('--tilt', '0deg');
      };
      stick.addEventListener('pointerdown', (e) => {
        e.preventDefault();
        stick.setPointerCapture(e.pointerId);
        apply(e);
      });
      stick.addEventListener('pointermove', (e) => {
        if (stick.hasPointerCapture(e.pointerId)) apply(e);
      });
      stick.addEventListener('pointerup', release);
      stick.addEventListener('pointercancel', release);
      stick.addEventListener('contextmenu', (e) => e.preventDefault());
    }

    // 画面から外れたり、タブが隠れたら一時停止
    const pause = (p: boolean) => playing && game?.setPaused(p);
    new IntersectionObserver(([entry]) => pause(!entry.isIntersecting), { threshold: 0.2 }).observe(screen);
    document.addEventListener('visibilitychange', () => pause(document.hidden));
  }
</script>

<style>
  .arcade-panel {
    z-index: 1;
    width: min(430px, 90%);
    height: 580px;
    margin: 85px auto 0;
    padding: 34px;
    background: #ddd8ca;
    transform: perspective(1000px) rotateY(7deg);
    box-shadow: -25px 25px 0 #090908;
  }
  .screen {
    position: relative;
    display: block;
    cursor: pointer;
    overflow: hidden;
    height: 370px;
    padding: 20px;
    border: 12px solid #2c2c27;
    background-color: #151c18;
    background-image: repeating-linear-gradient(0deg, transparent 0 4px, #b8ff3509 5px);
    box-shadow: inset 0 0 70px #b8ff3512;
    color: var(--acid);
    text-align: center;
  }
  .screen:focus-visible {
    outline: 2px solid var(--acid);
    outline-offset: 4px;
  }
  .attract[hidden],
  .stage[hidden],
  .result[hidden] {
    display: none;
  }
  .screen-score {
    position: absolute;
    top: 17px;
    left: 17px;
    font-size: 8px;
    letter-spacing: 0.15em;
  }
  .space-invader {
    width: 120px;
    height: 85px;
    margin: 45px auto 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 5px;
  }
  .space-invader i {
    background: var(--coral);
    box-shadow: 0 0 10px var(--coral);
  }
  /* インベーダーの形に抜く */
  .space-invader i:nth-child(1),
  .space-invader i:nth-child(5),
  .space-invader i:nth-child(7),
  .space-invader i:nth-child(9),
  .space-invader i:nth-child(11),
  .space-invader i:nth-child(13),
  .space-invader i:nth-child(15) {
    opacity: 0;
  }
  .screen strong {
    display: block;
    margin-top: 28px;
    font: 800 33px/1 var(--font-display);
  }
  .screen small {
    display: block;
    margin-top: 25px;
    font-size: 7px;
    animation: blink 1s infinite;
  }
  /* ゲーム中の画面：canvas は正方形（240×240）をドットのまま拡大する */
  .stage {
    position: absolute;
    inset: 0;
    cursor: default;
    touch-action: none;
  }
  canvas {
    display: block;
    height: 100%;
    aspect-ratio: 1;
    margin: 0 auto;
    image-rendering: pixelated;
  }
  .hud {
    position: absolute;
    top: 8px;
    left: 10px;
    right: 62px;
    display: flex;
    justify-content: space-between;
    font-size: 8px;
    letter-spacing: 0.12em;
  }
  .hint {
    position: absolute;
    bottom: 8px;
    left: 0;
    right: 0;
    text-align: center;
    font-size: 7px;
    letter-spacing: 0.1em;
    opacity: 0.7;
  }
  .sound {
    position: absolute;
    top: 4px;
    right: 32px;
    width: 26px;
    height: 26px;
    color: var(--acid);
    font-size: 12px;
    text-align: center;
  }
  .sound.off {
    opacity: 0.4;
    text-decoration: line-through;
  }
  .exit {
    position: absolute;
    top: 4px;
    right: 6px;
    width: 26px;
    height: 26px;
    color: var(--acid);
    font-size: 12px;
    text-align: center;
  }
  .exit:hover {
    color: var(--coral);
  }
  /* 操作のヒント：キーボードの端末ではキー、タッチ端末では「筐体のスティックとボタンで」と出す */
  .hint-touch {
    display: none;
  }
  @media (hover: none) and (pointer: coarse) {
    .hint-keys {
      display: none;
    }
    .hint-touch {
      display: block;
    }
  }
  .result {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    background: #0f1512e6;
    text-align: center;
  }
  .result strong {
    font: 800 30px/1 var(--font-display);
  }
  .result span {
    font-size: 9px;
    letter-spacing: 0.15em;
  }
  .result button,
  .result a {
    padding: 9px 16px;
    border: 1px solid var(--acid);
    font-size: 8px;
    letter-spacing: 0.14em;
    transition: background 0.2s, color 0.2s;
  }
  .result button:hover,
  .result a:hover {
    background: var(--acid);
    color: var(--ink);
  }
  .controls {
    position: relative;
    height: 120px;
  }
  .stick {
    position: absolute;
    left: 45px;
    bottom: 0;
    width: 75px;
    height: 75px;
    border-radius: 50%;
    background: #222;
    box-shadow: 0 7px 0 #090909;
    cursor: grab;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }
  .stick::after {
    content: '';
    position: absolute;
    left: 30px;
    bottom: 32px;
    width: 15px;
    height: 90px;
    border-radius: 10px;
    background: #333;
    /* レバーは根元を軸に、倒した向きへ傾く */
    transform-origin: 50% 90%;
    transform: rotate(var(--tilt, 0deg));
    transition: transform 0.08s linear;
  }
  .btn {
    position: absolute;
    width: 43px;
    height: 43px;
    border-radius: 50%;
    padding: 0;
    cursor: pointer;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    transition: transform 0.06s linear, box-shadow 0.06s linear;
  }
  .btn.heavy {
    right: 40px;
    bottom: 28px;
    background: var(--coral);
    box-shadow: 0 6px 0 #9a2e21;
  }
  .btn.light {
    right: 100px;
    bottom: 14px;
    background: var(--acid);
    box-shadow: 0 6px 0 #618f14;
  }
  /* 押している間は、ボタンが沈む */
  .btn.pressed {
    transform: translateY(5px);
  }
  .btn.heavy.pressed {
    box-shadow: 0 1px 0 #9a2e21;
  }
  .btn.light.pressed {
    box-shadow: 0 1px 0 #618f14;
  }
  @media (max-width: 900px) {
    .arcade-panel {
      order: 2;
    }
  }
  @media (max-width: 620px) {
    .arcade-panel {
      height: 500px;
      padding: 24px;
    }
    .screen {
      height: 340px;
    }
    .screen strong {
      margin-top: 22px;
      font-size: 26px;
    }
    .space-invader {
      margin-top: 34px;
    }
  }
</style>
