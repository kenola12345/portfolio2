---
/**
 * ヒーロー：見出し・紹介文・「制作実績へ」の丸いリンクと、右側の 3D ターンテーブル。
 * 3D（Turntable）と再生ボタン（NowPlaying）は React のアイランド。
 */
import ArrowIcon from './ArrowIcon.astro';
import Breakdancer from './Breakdancer.astro';
import NowPlaying from './NowPlaying';
import Turntable from './Turntable';
import { music } from '../../data/music';
import { home } from '../../data/home';
import { useT } from '../../lib/i18n';

const t = useT(Astro.url);
const h = home.headline;
const explore = t(home.explore).split('\n');
---

<section class="hero" id="home">
  <div class="hero-copy">
    <p class="eyebrow" data-hero="line"><span>01</span> {t(home.eyebrow)}</p>
    <h1>
      <span class="line" data-hero="line">{t(h.line1)}</span>
      <span class="line outline" data-hero="line">{t(h.line2)}</span>
      <span class="line" data-hero="line">{t(h.line3)} <i>{t(h.line3Accent)}</i></span>
    </h1>
    <!-- 紹介文と、その右隣のブレイクダンサー（PC）。画面の高さが低くても、文字に重ならない -->
    <div class="intro-row">
      <p class="intro" data-hero="line">{t(home.intro)}</p>
      <div class="b-slot"><Breakdancer /></div>
      <a class="round-link" href="#work" aria-label={explore.join(' ')} data-hero="pop">
      <ArrowIcon />
      <span>{explore[0]}<br />{explore[1]}</span>
    </a>
    </div>
  </div>

  <div class="hero-visual">
    <Turntable client:only="react" label={t(home.turntableLabel)} />
    <NowPlaying
      client:load
      kicker={t(home.nowSpinning)}
      tracks={music}
      playLabel={t(home.play)}
      pauseLabel={t(home.pause)}
      nextLabel={t(home.next)}
    />
  </div>

  <p class="scroll-cue">{t(home.scrollCue)} <span>↓</span></p>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    padding: calc(145 * var(--u)) var(--gutter) calc(56 * var(--u));
    display: grid;
    grid-template-columns: 52% 48%;
    overflow: hidden;
    background:
      radial-gradient(circle at 75% 45%, #33382b 0%, transparent 27%),
      linear-gradient(115deg, var(--ink) 0 54%, var(--ink-2) 54%);
  }
  /* 薄いノイズ */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.12;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 120 120' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.35'/%3E%3C/svg%3E");
  }
  .hero-copy {
    position: relative;
    z-index: 2;
  }
  .eyebrow {
    display: flex;
    gap: calc(18 * var(--u));
    align-items: center;
    text-transform: uppercase;
    font-size: 0.625rem;
    letter-spacing: 0.14em;
  }
  .eyebrow span {
    color: var(--acid);
  }
  h1 {
    margin: 10vh 0 calc(32 * var(--u));
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(4rem, 8.1vw, 8.5rem);
    letter-spacing: -0.075em;
    line-height: 0.82;
    white-space: nowrap;
  }
  .line {
    display: block;
  }
  /* 日本語は 1 文字が大きく、行も詰まると読みにくいので、少し小さくして行間をとる */
  :global(html[lang='ja']) h1 {
    font-size: clamp(3.25rem, 6.6vw, 7rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }
  :global(html[lang='ja']) .outline {
    -webkit-text-stroke-width: 2px;
  }
  .outline {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--paper);
    transform: translateX(7vw);
  }
  h1 i {
    color: var(--acid);
    font-style: normal;
  }
  .intro {
    max-width: calc(470 * var(--u));
    margin-left: calc(6 * var(--u));
    color: var(--muted);
    font-size: 0.8125rem;
    line-height: 1.75;
  }
  .round-link {
    position: relative;
    z-index: 3;
    flex: none;
    margin-left: auto;
    width: calc(122 * var(--u));
    height: calc(122 * var(--u));
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: calc(10 * var(--u));
    border: 1px solid #77766e;
    border-radius: 50%;
    font-size: 0.5625rem;
    letter-spacing: 0.08em;
    transition: 0.4s;
  }
  .round-link:hover {
    background: var(--acid);
    color: var(--ink);
    border-color: var(--acid);
    transform: rotate(8deg);
  }
  /* 矢印は、文字の上に重ねず、上に並べる（子コンポーネントの svg には scoped の指定が届かないので :global） */
  .round-link :global(svg) {
    width: calc(24 * var(--u));
    height: calc(24 * var(--u));
    transition: transform 0.7s var(--ease-out);
  }
  /* ホバーで、矢印が右上へ動きながら、縦の軸まわりに立体的に 1 回転（コインを回すように）する。円を描くようには回らない */
  .round-link:hover :global(svg) {
    transform: perspective(calc(120 * var(--u))) translate(calc(3 * var(--u)), calc(-3 * var(--u))) rotateY(360deg);
  }
  .round-link span {
    text-align: center;
    line-height: 1.4;
  }
  /* 紹介文の右隣にブレイクダンサーを置く（紹介文より下に絶対配置すると、画面が低いときに文字と重なる） */
  .intro-row {
    display: flex;
    align-items: flex-end;
    gap: calc(30 * var(--u));
  }
  .b-slot {
    flex: none;
    width: calc(130 * var(--u));
  }
  .hero-visual {
    position: relative;
    z-index: 1;
    min-width: 0;
  }
  .scroll-cue {
    position: absolute;
    left: var(--gutter);
    bottom: calc(26 * var(--u));
    font-size: 0.5rem;
    letter-spacing: 0.14em;
    color: var(--muted-dim);
  }
  .scroll-cue span {
    margin-left: calc(8 * var(--u));
    color: var(--acid);
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      padding-top: calc(125 * var(--u));
    }
    .hero-copy {
      z-index: 3;
    }
    h1 {
      margin-top: calc(55 * var(--u));
      font-size: clamp(3.5rem, 15vw, 6.25rem);
    }
    /* ボタンはぐるっと外に出さず、紹介文の下に普通に置く（外に出すと、ヒーローの下端で切れる） */
    .round-link {
      margin-left: 0;
      margin-top: calc(36 * var(--u));
    }
    .intro-row {
      display: block;
    }
    .b-slot {
      position: absolute;
      right: 6%;
      bottom: 0;
      width: calc(110 * var(--u));
    }
    /* ターンテーブルも、絶対配置をやめて、コピーの下に並べる */
    .hero-visual {
      height: calc(400 * var(--u));
      margin: 0 -10% 0 0;
    }
  }
  @media (max-width: 620px) {
    .hero {
      min-height: 0;
      padding-inline: calc(20 * var(--u));
    }
    h1 {
      /* 「FULL STACK」が 1 行に収まる大きさ（nowrap のため、大きいとはみ出す） */
      font-size: 9.6vw;
      letter-spacing: -0.06em;
    }
    :global(html[lang='ja']) h1 {
      font-size: 11.5vw;
    }
    .outline {
      transform: translateX(3vw);
    }
    .intro {
      width: 82%;
    }
    .hero-visual {
      margin: 0 -31% 0 -5%;
    }
    .round-link {
      width: calc(100 * var(--u));
      height: calc(100 * var(--u));
    }
  }
</style>
