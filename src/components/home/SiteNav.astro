---
/**
 * 上部のナビ：名前のロゴ、各セクションへのリンク、言語の切り替え、連絡先リンク。
 * 画面が狭いとき（900px 以下）はメニューボタンで開閉する。
 */
import { artist } from '../../data/artist';
import { home } from '../../data/home';
import { alternatePath, getLang, localePath, useT } from '../../lib/i18n';

const t = useT(Astro.url);
const lang = getLang(Astro.url);
const alt = alternatePath(Astro.url);
const email = artist.socials.find((s) => s.kind === 'email');
const [first = '', ...rest] = t(artist.name).split(/\s+/);

const links = [
  { href: '#work', label: t(home.nav.work) },
  { href: '#about', label: t(home.nav.about) },
  { href: '#contact', label: t(home.nav.contact) },
];
---

<nav class="site-nav" data-reveal-nav>
  <a class="brand" href={localePath('/', lang)} aria-label={t(artist.name)}>
    <span class="brand-mark">KO</span>
    <span>{first}<br />{rest.join(' ')}</span>
  </a>

  <div class="nav-links" id="nav-links">
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
  </div>

  <div class="nav-end">
    <a class="lang" href={alt.href} hreflang={alt.lang} lang={alt.lang}>{alt.lang === 'ja' ? '日本語' : 'EN'}</a>
    {
      email && (
        <a class="available" href={email.href}>
          <span /> {t(home.nav.sayHello)}
        </a>
      )
    }
    <button class="menu-toggle" aria-expanded="false" aria-controls="nav-links">{t(home.nav.menu)}</button>
  </div>
</nav>

<style>
  .site-nav {
    position: absolute;
    inset: 0 0 auto;
    z-index: 10;
    height: 92px;
    padding: 0 var(--gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--line);
    font-size: 10px;
    letter-spacing: 0.12em;
  }
  .brand {
    display: flex;
    gap: 12px;
    align-items: center;
    line-height: 1.25;
    text-transform: uppercase;
  }
  .brand-mark {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--acid);
    color: var(--ink);
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-weight: 800;
    letter-spacing: -0.1em;
  }
  .nav-links {
    display: flex;
    gap: 40px;
    text-transform: uppercase;
  }
  .nav-links a {
    transition: color 0.2s;
  }
  .nav-links a:hover {
    color: var(--acid);
  }
  .nav-end {
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .lang {
    text-transform: uppercase;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 6px 12px;
    transition: border-color 0.2s, color 0.2s;
  }
  .lang:hover {
    color: var(--acid);
    border-color: var(--acid);
  }
  .available {
    display: flex;
    gap: 9px;
    align-items: center;
  }
  .available > span {
    width: 7px;
    height: 7px;
    background: var(--acid);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--acid);
    animation: blink 2s infinite;
  }
  .menu-toggle {
    display: none;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 8px 14px;
  }

  @media (max-width: 900px) {
    .menu-toggle {
      display: block;
    }
    .nav-links {
      display: none;
      position: absolute;
      inset: 92px 0 auto;
      flex-direction: column;
      gap: 0;
      background: var(--ink);
      border-bottom: 1px solid var(--line);
      padding: 8px var(--gutter) 20px;
      font-size: 13px;
    }
    .nav-links a {
      padding: 16px 0;
      border-bottom: 1px solid var(--line);
    }
    .site-nav:has(.menu-toggle[aria-expanded='true']) .nav-links {
      display: flex;
    }
  }
  @media (max-width: 620px) {
    .site-nav {
      padding: 0 20px;
    }
    .nav-links {
      padding-inline: 20px;
    }
    .available {
      font-size: 0;
      gap: 0;
    }
    .nav-end {
      gap: 14px;
    }
  }
</style>
