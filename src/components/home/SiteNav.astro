---
/**
 * 上部のナビ：名前のロゴ、各セクションへのリンク、言語の切り替え、連絡先リンク。
 * 画面が狭いとき（900px 以下）はメニューボタンで開閉する。
 */
import { artist } from '../../data/artist';
import { home } from '../../data/home';
import { alternatePath, getLang, localePath, useT } from '../../lib/i18n';

const t = useT(Astro.url);
const lang = getLang(Astro.url);
const alt = alternatePath(Astro.url);
const email = artist.socials.find((s) => s.kind === 'email');
const [first = '', ...rest] = t(artist.name).split(/\s+/);

interface NavLink {
  href: string;
  label: string;
  /** いま見ているページ（色を変える） */
  current?: boolean;
}
interface Props {
  /** 省略するとホームのセクション（#work / #about / #contact）へのリンク */
  links?: NavLink[];
  /** true（既定）のときは画面の上端に重ねる。サブページでは false にして、普通に上に置く */
  overlay?: boolean;
}

const { links = [
  { href: '#work', label: t(home.nav.work) },
  { href: '#about', label: t(home.nav.about) },
  { href: '#contact', label: t(home.nav.contact) },
], overlay = true } = Astro.props;
---

<nav class:list={['site-nav', { flow: !overlay }]} data-reveal-nav>
  <a class="brand" href={localePath('/', lang)} aria-label={t(artist.name)}>
    <span class="brand-mark">KO</span>
    <span>{first}<br />{rest.join(' ')}</span>
  </a>

  <div class="nav-links" id="nav-links">
    {links.map((l) => <a href={l.href} aria-current={l.current ? 'page' : undefined}>{l.label}</a>)}
  </div>

  <div class="nav-end">
    <a class="lang" href={alt.href} hreflang={alt.lang} lang={alt.lang}>{alt.lang === 'ja' ? '日本語' : 'EN'}</a>
    {
      email && (
        <a class="available" href={email.href}>
          <span /> {t(home.nav.sayHello)}
        </a>
      )
    }
    <button class="menu-toggle" aria-expanded="false" aria-controls="nav-links">{t(home.nav.menu)}</button>
  </div>
</nav>

<style>
  .site-nav {
    position: absolute;
    inset: 0 0 auto;
    z-index: 10;
    height: calc(92 * var(--u));
    padding: 0 var(--gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--line);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
  }
  .brand {
    display: flex;
    gap: calc(12 * var(--u));
    align-items: center;
    line-height: 1.25;
    text-transform: uppercase;
  }
  .brand-mark {
    width: calc(38 * var(--u));
    height: calc(38 * var(--u));
    border-radius: 50%;
    background: var(--acid);
    color: var(--ink);
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-weight: 800;
    letter-spacing: -0.1em;
  }
  .site-nav.flow {
    position: relative;
    background: var(--ink);
  }
  .nav-links {
    display: flex;
    gap: clamp(calc(16 * var(--u)), 2.6vw, calc(40 * var(--u)));
    text-transform: uppercase;
  }
  .nav-links a {
    transition: color 0.2s;
  }
  .nav-links a:hover,
  .nav-links a[aria-current='page'] {
    color: var(--acid);
  }
  .nav-end {
    display: flex;
    align-items: center;
    gap: calc(28 * var(--u));
  }
  .lang {
    text-transform: uppercase;
    border: 1px solid var(--line);
    border-radius: calc(999 * var(--u));
    padding: calc(6 * var(--u)) calc(12 * var(--u));
    transition: border-color 0.2s, color 0.2s;
  }
  .lang:hover {
    color: var(--acid);
    border-color: var(--acid);
  }
  .available {
    display: flex;
    gap: calc(9 * var(--u));
    align-items: center;
  }
  .available > span {
    width: calc(7 * var(--u));
    height: calc(7 * var(--u));
    background: var(--acid);
    border-radius: 50%;
    box-shadow: 0 0 calc(10 * var(--u)) var(--acid);
    animation: blink 2s infinite;
  }
  .menu-toggle {
    display: none;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    border: 1px solid var(--line);
    border-radius: calc(999 * var(--u));
    padding: calc(8 * var(--u)) calc(14 * var(--u));
  }

  @media (max-width: 900px) {
    .menu-toggle {
      display: block;
    }
    .nav-links {
      display: none;
      position: absolute;
      inset: calc(92 * var(--u)) 0 auto;
      flex-direction: column;
      gap: 0;
      background: var(--ink);
      border-bottom: 1px solid var(--line);
      padding: calc(8 * var(--u)) var(--gutter) calc(20 * var(--u));
      font-size: 0.8125rem;
    }
    .nav-links a {
      padding: calc(16 * var(--u)) 0;
      border-bottom: 1px solid var(--line);
    }
    .site-nav:has(.menu-toggle[aria-expanded='true']) .nav-links {
      display: flex;
    }
  }
  @media (max-width: 620px) {
    .site-nav {
      padding: 0 calc(20 * var(--u));
    }
    .nav-links {
      padding-inline: calc(20 * var(--u));
    }
    .available {
      font-size: 0;
      gap: 0;
    }
    .nav-end {
      gap: calc(14 * var(--u));
    }
  }
</style>
