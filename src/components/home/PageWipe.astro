---
/**
 * ページ移動のときに下から上がってくる赤いワイプ（"SIDE B"）。
 * 動かしているのは scripts/side-b-motion.ts。リンクを押すと .active が付き、閉じ切ってから移動する
 */
---

<div class="page-wipe" aria-hidden="true">
  <span>SIDE B</span>
</div>

<style>
  .page-wipe {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    background: var(--coral);
    color: var(--ink);
    transform: translateY(100%);
    transition: transform 0.35s cubic-bezier(0.7, 0, 0.3, 1);
    pointer-events: none;
  }
  .page-wipe:global(.active) {
    transform: translateY(0);
  }
  .page-wipe span {
    font: 800 15vw var(--font-display);
    letter-spacing: -0.08em;
  }
</style>
