---
/**
 * ページ移動のときに下から上がってくる赤いワイプ（"SIDE B"）。
 * 動かしているのは scripts/side-b-motion.ts。リンクを押すと .active が付き、閉じ切ってから移動する
 */
---

<div class="page-wipe" aria-hidden="true">
  <span>SIDE B</span>
</div>

<style>
  /* 閉じる：下から上がってきて画面を覆う */
  .page-wipe {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: var(--coral);
    color: var(--ink);
    transform: translateY(100%);
    transition: transform 0.45s cubic-bezier(0.7, 0, 0.3, 1);
    pointer-events: none;
    will-change: transform;
    /* 普段は完全に隠す。iOS は画面の端にある固定要素の色をツールバーに映すので、画面の外に置いてあるだけだと、
       赤いワイプの色が上下のバーに出たり、スクロール中に見えてしまう */
    visibility: hidden;
  }
  .page-wipe:global(.active),
  .page-wipe:global(.leaving),
  :global(html[data-wipe-arrive]) .page-wipe {
    visibility: visible;
  }
  .page-wipe:global(.active) {
    transform: translateY(0);
  }
  .page-wipe span {
    font: 800 15vw var(--font-display);
    letter-spacing: -0.08em;
    transition: transform 0.55s cubic-bezier(0.7, 0, 0.3, 1);
  }
  /* 移動先のページを開いた直後：覆った状態から始まり（head のスクリプトが data-wipe-arrive を付ける）、
     そのまま上へ抜けていく。「閉じる」と「開く」で 1 つの動きに見える */
  :global(html[data-wipe-arrive]) .page-wipe {
    transform: translateY(0);
    transition: none;
  }
  .page-wipe:global(.leaving) {
    transform: translateY(-100%);
    transition: transform 0.6s cubic-bezier(0.7, 0, 0.3, 1);
  }
  .page-wipe:global(.leaving) span {
    transform: translateY(-30%);
  }
  .page-wipe:global(.active) span {
    transform: translateY(0);
  }
</style>
