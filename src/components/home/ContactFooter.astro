---
/**
 * ページ下部の連絡先（アシッドグリーンの背景）：メールへの大きなリンク、SNS、著作権表示。
 * メール・SNS はアーティストデータから出す。
 */
import ArrowIcon from './ArrowIcon.astro';
import SocialLinks from './SocialLinks.astro';
import { artist } from '../../data/artist';
import { home } from '../../data/home';
import { useT } from '../../lib/i18n';

const t = useT(Astro.url);
const email = artist.socials.find((s) => s.kind === 'email');
const kicker = t(home.contact.kicker).split('\n');
const year = new Date().getFullYear();
---

<footer id="contact">
  <p class="kicker" data-reveal>{kicker[0]}<br />{kicker[1]}</p>
  {
    email && (
      <a class="big" href={email.href} data-reveal>
        {t(home.contact.cta)}<br /><i>{t(home.contact.ctaAccent)}</i><ArrowIcon />
      </a>
    )
  }
  <!-- GitHub と LinkedIn は、アイコン付きの大きなボタンで目立たせる -->
  <SocialLinks variant="footer" kinds={['github', 'linkedin']} />
  <div class="footer-bottom">
    <span>© {year} {t(artist.name).toUpperCase()}</span>
    <a class="top" href="#home">{t(home.contact.top)}</a>
  </div>
  <!-- このサイトの技術スタック -->
  <p class="stack">{t(home.contact.stack)}</p>
</footer>

<style>
  footer {
    /* 下に余白を多めにとる：右下に固定されるミュージックプレイヤーが、文字に重ならないように */
    padding: calc(70 * var(--u)) var(--gutter) calc(108 * var(--u));
    background: var(--acid);
    color: var(--ink);
  }
  .kicker {
    font-size: 0.625rem;
    letter-spacing: 0.14em;
  }
  .big {
    position: relative;
    display: block;
    margin: calc(75 * var(--u)) 0 calc(56 * var(--u));
    font: 800 clamp(3rem, 7.6vw, 8.125rem) / 0.84 var(--font-display);
    letter-spacing: -0.08em;
    white-space: nowrap;
  }
  .big i {
    color: var(--ink);
    font-style: normal;
    -webkit-text-stroke: 2px var(--ink);
  }
  .big :global(svg) {
    display: inline;
    width: 8vw;
    margin-left: calc(30 * var(--u));
    stroke-width: 0.7;
    transition: transform 0.7s var(--ease-out);
  }
  /* 右上へ動きながら、縦の軸まわりに立体的に 1 回転する */
  .big:hover :global(svg) {
    transform: perspective(calc(400 * var(--u))) translate(calc(10 * var(--u)), calc(-10 * var(--u))) rotateY(360deg);
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    margin-top: calc(80 * var(--u));
    padding-top: calc(20 * var(--u));
    border-top: 1px solid var(--ink);
    font-size: 0.5rem;
    letter-spacing: 0.1em;
  }
  .stack {
    margin-top: calc(14 * var(--u));
    font-size: 0.5rem;
    letter-spacing: 0.1em;
    line-height: 1.8;
    opacity: 0.75;
  }
  .footer-bottom a:hover {
    text-decoration: underline;
  }
  @media (max-width: 620px) {
    footer {
      padding: calc(60 * var(--u)) calc(20 * var(--u)) calc(108 * var(--u));
    }
    .big {
      margin: calc(60 * var(--u)) 0 calc(80 * var(--u));
      font-size: 13vw;
      white-space: normal;
    }
    .big :global(svg) {
      width: 11vw;
      margin-left: calc(12 * var(--u));
    }
    .footer-bottom {
      flex-wrap: wrap;
      gap: calc(20 * var(--u));
    }
  }
</style>
