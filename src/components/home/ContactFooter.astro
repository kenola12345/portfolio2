---
/**
 * ページ下部の連絡先（アシッドグリーンの背景）：メールへの大きなリンク、SNS、著作権表示。
 * メール・SNS はアーティストデータから出す。
 */
import ArrowIcon from './ArrowIcon.astro';
import { artist } from '../../data/artist';
import { home } from '../../data/home';
import { useT } from '../../lib/i18n';

const t = useT(Astro.url);
const email = artist.socials.find((s) => s.kind === 'email');
const socials = artist.socials.filter((s) => s.kind !== 'email');
const kicker = t(home.contact.kicker).split('\n');
const year = new Date().getFullYear();
---

<footer id="contact">
  <p class="kicker" data-reveal>{kicker[0]}<br />{kicker[1]}</p>
  {
    email && (
      <a class="big" href={email.href} data-reveal>
        {t(home.contact.cta)}<br /><i>{t(home.contact.ctaAccent)}</i><ArrowIcon />
      </a>
    )
  }
  <div class="footer-bottom">
    <span>© {year} {t(artist.name).toUpperCase()}</span>
    <div>
      {socials.map((s) => <a href={s.href} target="_blank" rel="noreferrer">{t(s.label).toUpperCase()}</a>)}
    </div>
    <a class="top" href="#home">{t(home.contact.top)}</a>
  </div>
</footer>

<style>
  footer {
    padding: 70px var(--gutter) 28px;
    background: var(--acid);
    color: var(--ink);
  }
  .kicker {
    font-size: 10px;
    letter-spacing: 0.14em;
  }
  .big {
    position: relative;
    display: block;
    margin: 75px 0 100px;
    font: 800 clamp(48px, 7.6vw, 130px) / 0.84 var(--font-display);
    letter-spacing: -0.08em;
    white-space: nowrap;
  }
  .big i {
    color: var(--ink);
    font-style: normal;
    -webkit-text-stroke: 2px var(--ink);
  }
  .big :global(svg) {
    display: inline;
    width: 8vw;
    margin-left: 30px;
    stroke-width: 0.7;
    transition: transform 0.4s var(--ease-out);
  }
  .big:hover :global(svg) {
    transform: translate(10px, -10px);
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    padding-top: 20px;
    border-top: 1px solid var(--ink);
    font-size: 8px;
    letter-spacing: 0.1em;
  }
  .footer-bottom div {
    display: flex;
    gap: 35px;
  }
  .footer-bottom a:hover {
    text-decoration: underline;
  }
  @media (max-width: 620px) {
    footer {
      padding: 60px 20px 25px;
    }
    .big {
      margin: 60px 0 80px;
      font-size: 13vw;
      white-space: normal;
    }
    .big :global(svg) {
      width: 11vw;
      margin-left: 12px;
    }
    .footer-bottom {
      flex-wrap: wrap;
      gap: 20px;
    }
    .footer-bottom div {
      order: 3;
      width: 100%;
      gap: 20px;
    }
  }
</style>
