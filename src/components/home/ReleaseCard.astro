---
/**
 * 代表的な制作実績 1 件ぶんのカード。ジャケット（スクリーンショット）の後ろにレコードが隠れていて、
 * ホバーするとジャケットが左へずれ、レコードが回りながら出てくる。
 */
import ArrowIcon from './ArrowIcon.astro';

interface Props {
  index: number;
  title: string;
  type: string;
  cover: string;
  alt: string;
  href: string;
  /** レコード中央のラベルの色 */
  color: string;
  viewLabel: string;
}

const { index, title, type, cover, alt, href, color, viewLabel } = Astro.props;
---

<article class="project" data-reveal>
  <a class="card-link" href={href} aria-label={`${viewLabel}: ${title}`}>
    <div class="sleeve-wrap">
      <div class="vinyl-disc" style={`--label: ${color}`}><span></span></div>
      <div class="project-sleeve">
        <img src={cover} alt={alt} width="1200" height="1200" loading="lazy" />
      </div>
      <span class="go"><ArrowIcon /></span>
    </div>
    <div class="project-meta">
      <span>{String(index + 1).padStart(2, '0')}</span>
      <div>
        <h3>{title}</h3>
        <p>{type}</p>
      </div>
    </div>
  </a>
</article>

<style>
  .card-link {
    display: block;
  }
  .sleeve-wrap {
    position: relative;
    aspect-ratio: 1;
    margin-bottom: 26px;
  }
  .project-sleeve {
    position: absolute;
    inset: 0;
    z-index: 2;
    overflow: hidden;
    background: #1a1a17;
    box-shadow: 0 20px 35px #1a1a171e;
    transition: transform 0.5s var(--ease-out);
  }
  .project-sleeve img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .vinyl-disc {
    position: absolute;
    top: 5%;
    right: -1%;
    width: 90%;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: repeating-radial-gradient(circle, #161614 0 2px, #292925 3px, #111 5px);
    box-shadow: 0 15px 20px #0003;
    transition: transform 0.6s ease;
  }
  .vinyl-disc span {
    width: 31%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--label);
    border: 6px solid var(--ink);
  }
  .card-link:hover .project-sleeve,
  .card-link:focus-visible .project-sleeve {
    transform: translateX(-13%);
  }
  .card-link:hover .vinyl-disc,
  .card-link:focus-visible .vinyl-disc {
    transform: translateX(17%) rotate(80deg);
  }
  .go {
    position: absolute;
    z-index: 4;
    right: 15px;
    bottom: 15px;
    width: 50px;
    height: 50px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    transition: 0.25s;
  }
  .card-link:hover .go {
    background: var(--acid);
    transform: rotate(10deg);
  }
  .go :global(svg) {
    width: 22px;
  }
  .project-meta {
    display: grid;
    grid-template-columns: 32px 1fr;
    align-items: start;
    padding-top: 16px;
    border-top: 1px solid #aaa69a;
  }
  .project-meta > span {
    font-size: 8px;
    color: #77736c;
  }
  .project-meta h3 {
    font: 700 22px var(--font-display);
    letter-spacing: -0.04em;
  }
  .project-meta p {
    margin-top: 5px;
    font-size: 9px;
    color: #77736c;
  }
</style>
