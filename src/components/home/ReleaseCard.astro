---
/**
 * 代表的な制作実績 1 件ぶんのカード。ジャケット（スクリーンショット）の後ろにレコードが隠れていて、
 * ホバーするとジャケットが左へずれ、レコードが回りながら出てくる。
 */
import ArrowIcon from './ArrowIcon.astro';

interface Props {
  index: number;
  title: string;
  type: string;
  cover: string;
  alt: string;
  href: string;
  /** レコード中央のラベルの色 */
  color: string;
  viewLabel: string;
  /** スクロールで現れる動き（流れるレールの中では不要なので切れる） */
  reveal?: boolean;
}

const { index, title, type, cover, alt, href, color, viewLabel, reveal = true } = Astro.props;
---

<article class="project" data-reveal={reveal ? '' : undefined}>
  <a class="card-link" href={href} aria-label={`${viewLabel}: ${title}`}>
    <div class="sleeve-wrap">
      <div class="vinyl-disc" style={`--label: ${color}`}><span></span></div>
      <div class="project-sleeve">
        <img src={cover} alt={alt} width="1200" height="1200" loading="lazy" />
      </div>
      <span class="go"><ArrowIcon /></span>
    </div>
    <div class="project-meta">
      <span>{String(index + 1).padStart(2, '0')}</span>
      <div>
        <h3>{title}</h3>
        <p>{type}</p>
      </div>
    </div>
  </a>
</article>

<script>
  /**
   * タッチ端末でカードをタップしたとき：レコードが飛び出してジャケットがずれる動きを見せてから、ページを移る。
   * スクロールやスライダーのドラッグ（click が打ち消される）では動かない。戻ってきたとき（キャッシュ復元）は元に戻す。
   */
  const isTouch = window.matchMedia('(hover: none) and (pointer: coarse)').matches;
  if (isTouch && !(window as unknown as { __cardTap?: boolean }).__cardTap) {
    (window as unknown as { __cardTap?: boolean }).__cardTap = true;
    document.addEventListener('click', (e) => {
      if (e.defaultPrevented) return; // ドラッグのあとの click は、スライダーが打ち消している
      const link = (e.target as Element).closest<HTMLAnchorElement>('.project > .card-link');
      if (!link || link.dataset.go) return;
      e.preventDefault();
      link.closest('.project')?.setAttribute('data-tapped', '');
      window.setTimeout(() => {
        link.dataset.go = '1';
        link.click(); // 2 回目の click は、ふつうのリンクとして（ページ移動のワイプへ）進む
      }, 520);
    });
    window.addEventListener('pageshow', (e) => {
      if (!e.persisted) return;
      document.querySelectorAll('.project[data-tapped]').forEach((el) => el.removeAttribute('data-tapped'));
      document.querySelectorAll<HTMLAnchorElement>('.card-link[data-go]').forEach((a) => delete a.dataset.go);
    });
  }
</script>

<style>
  .card-link {
    display: block;
  }
  .sleeve-wrap {
    position: relative;
    aspect-ratio: 1;
    margin-bottom: 26px;
  }
  .project-sleeve {
    position: absolute;
    inset: 0;
    z-index: 2;
    overflow: hidden;
    background: #1a1a17;
    box-shadow: 0 20px 35px #1a1a171e;
    transition: transform 0.5s var(--ease-out);
  }
  .project-sleeve img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .vinyl-disc {
    position: absolute;
    /* ジャケットと同じ大きさの円（正方形のジャケットに、ぴったり重なる） */
    top: 1.5%;
    right: 0;
    width: 97%;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: repeating-radial-gradient(circle, #161614 0 2px, #292925 3px, #111 5px);
    box-shadow: 0 15px 20px #0003;
    transition: transform 0.6s ease;
  }
  .vinyl-disc span {
    width: 31%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--label);
    border: 6px solid var(--ink);
  }
  /* ホバーの動きは、マウスのある端末だけ（タッチ端末では、触れたあとも :hover が残り続けて、勝手にずれたままになるため） */
  @media (hover: hover) {
    .card-link:hover .project-sleeve,
    .card-link:focus-visible .project-sleeve {
      transform: translateX(-13%);
    }
    .card-link:hover .vinyl-disc,
    .card-link:focus-visible .vinyl-disc {
      transform: translateX(17%) rotate(80deg);
    }
  }
  /* タッチ端末：スクロールやスライダーのドラッグでは動かさず、カードを「タップ」したときだけ、同じ動きをする
     （data-tapped は下のスクリプトが付ける。ページを移る前に見せて、戻ってきたら外れる） */
  .project[data-tapped] .project-sleeve {
    transform: translateX(-13%);
  }
  .project[data-tapped] .vinyl-disc {
    transform: translateX(17%) rotate(80deg);
  }
  .project[data-tapped] .go {
    background: var(--acid);
    transform: rotate(10deg);
  }
  .go {
    position: absolute;
    z-index: 4;
    right: 15px;
    bottom: 15px;
    width: 50px;
    height: 50px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    transition: 0.25s;
  }
  .card-link:hover .go {
    background: var(--acid);
    transform: rotate(10deg);
  }
  .go :global(svg) {
    width: 22px;
  }
  .project-meta {
    display: grid;
    grid-template-columns: 32px 1fr;
    align-items: start;
    padding-top: 16px;
    border-top: 1px solid #aaa69a;
  }
  .project-meta > span {
    font-size: 8px;
    color: #77736c;
  }
  .project-meta h3 {
    font: 700 22px var(--font-display);
    letter-spacing: -0.04em;
  }
  .project-meta p {
    margin-top: 5px;
    font-size: 9px;
    color: #77736c;
  }
</style>
