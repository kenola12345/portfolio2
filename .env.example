# お問い合わせフォーム（EmailJS + Google reCAPTCHA v2「私はロボットではありません」）。
# EmailJS が未設定のときは mailto: にフォールバックする。
# EmailJS のテンプレートでは {{name}} {{email}} {{message}} を使う。
PUBLIC_EMAILJS_SERVICE_ID=
PUBLIC_EMAILJS_TEMPLATE_ID=
PUBLIC_EMAILJS_PUBLIC_KEY=

# reCAPTCHA v2 のサイトキー（公開してよい方のキー）。
# シークレットキーは EmailJS のダッシュボード（Account > Security の reCAPTCHA 設定）に登録する。
# このサイトのコードにシークレットは置かない。
# 未設定でも `npm run dev` のときだけ Google 公式のテスト用キーでウィジェットを表示する。
PUBLIC_RECAPTCHA_SITE_KEY=
