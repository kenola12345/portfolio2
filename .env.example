# 公開する URL（例: https://example.com）。SNS の共有画像・canonical・言語ごとの alternate に使う。
# Vercel では自動で本番の URL が使われるので、独自ドメインのときだけ指定する。
SITE_URL=

# ランキング（Firebase の Firestore）。Firebase コンソールの「ウェブアプリ」の設定にある値。未設定ならランキングは出ない。
# Vercel の Environment Variables にも同じ名前で登録する。
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=
